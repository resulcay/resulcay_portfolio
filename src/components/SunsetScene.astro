---
import skySketch from '@/assets/diorama/sky-sketch.webp?url';
import skyPaint from '@/assets/diorama/sky-paint.webp?url';
import seaSketch from '@/assets/diorama/sea-sketch.webp?url';
import seaPaint from '@/assets/diorama/sea-paint.webp?url';
import cliffSketch from '@/assets/diorama/cliff-sketch.webp?url';
import cliffPaint from '@/assets/diorama/cliff-paint.webp?url';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// Back to front: sky and sun; sea; cliff and house. Depth scales how far each moves with the pointer.
const layers = [
  { depth: 0.3, sketch: skySketch, paint: skyPaint },
  { depth: 0.6, sketch: seaSketch, paint: seaPaint },
  { depth: 1, sketch: cliffSketch, paint: cliffPaint },
];
---
{/*
  The Story mode card's art as a watercolour diorama, after motion.dev's "Ocarina of Time
  watercolour" example: the sunset over the sea and the house on the cliff, painted in three
  layers on parchment with a torn edge. Each layer is a pencil sketch with its painting over it,
  baked into images by scripts/bake-diorama.mjs (the watercolour's noise filters are far too
  costly to run live on phones). Shown in full here, the card is painted; the home show paints
  each layer in over its sketch with one long brush stroke, and moves the layers with the
  pointer (scripts/diorama-reveal.ts, scripts/home-show.ts). It fills its box, cropping the sides.
*/}
<div class:list={['diorama', className]} data-diorama aria-hidden="true">
  {
    layers.map((layer) => (
      <div class="diorama__layer" data-depth={layer.depth}>
        <img class="diorama__sketch" src={layer.sketch} alt="" width="1920" height="1200" decoding="async" />
        <img class="diorama__paint" src={layer.paint} alt="" width="1920" height="1200" decoding="async" />
      </div>
    ))
  }
  <svg class="diorama__frame" viewBox="0 0 1440 900" preserveAspectRatio="none">
    <defs>
      <!-- The paper's torn edge. -->
      <filter id="diorama-torn" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.06" numOctaves="3" seed="6" result="noise"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="18" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
      </filter>
    </defs>
    <!-- The parchment margin, torn along its inner edge. -->
    <path fill="#efe3cc" fill-rule="evenodd" filter="url(#diorama-torn)" d="M-120-120H1560V1020H-120ZM14 22H1426V878H14Z"></path>
  </svg>
</div>

<style>
  .diorama {
    overflow: hidden;
  }
  .diorama__layer,
  .diorama__frame,
  .diorama__layer > :global(*) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .diorama__layer > :global(img) {
    object-fit: cover;
  }
  /* Room to move with the pointer without showing an edge. */
  .diorama__layer {
    scale: 1.06;
    will-change: transform;
  }
  .diorama__frame {
    z-index: 1;
  }
</style>
