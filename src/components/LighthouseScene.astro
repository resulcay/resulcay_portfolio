---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
{/* The Writing section's art: the lighthouse on the cliff at dusk, its beam sweeping over the sea, in the sunset art's banded style. It fills its box, keeping the lighthouse on the right. */}
<svg class={className} viewBox="0 0 1200 640" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id="lighthouse-beam" x1="1" y1="0" x2="0" y2="0">
      <stop offset="0" stop-color="#f6c47e" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#f6c47e" stop-opacity="0"></stop>
    </linearGradient>
  </defs>
  <rect width="1200" height="230" fill="#2a2342"></rect>
  <rect y="230" width="1200" height="110" fill="#3b3060"></rect>
  <rect y="340" width="1200" height="60" fill="#5b4b8a"></rect>
  <rect y="400" width="1200" height="40" fill="#9a6a86"></rect>
  <g fill="#f4ebdd">
    <circle cx="120" cy="60" r="1.6" opacity="0.7"></circle>
    <circle cx="300" cy="120" r="1.2" opacity="0.5"></circle>
    <circle cx="470" cy="40" r="1.8" opacity="0.8"></circle>
    <circle cx="640" cy="150" r="1.2" opacity="0.5"></circle>
    <circle cx="790" cy="70" r="1.5" opacity="0.7"></circle>
    <circle cx="930" cy="130" r="1.2" opacity="0.5"></circle>
    <circle cx="1110" cy="50" r="1.6" opacity="0.7"></circle>
    <circle cx="210" cy="190" r="1" opacity="0.4"></circle>
  </g>
  <rect y="440" width="1200" height="200" fill="#2f6f73"></rect>
  <path d="M80 470H260M380 500H560M120 540H300M640 480H760M460 580H700M200 610H380" stroke="#8fd0d4" stroke-width="3" stroke-linecap="round" opacity="0.25"></path>
  <polygon class="lighthouse__beam" points="1040,276 -200,150 -200,400" fill="url(#lighthouse-beam)"></polygon>
  <path d="M300 452H480M560 466H700M380 484H520" stroke="#f6c47e" stroke-width="3" stroke-linecap="round" opacity="0.45"></path>
  <path d="M860 640 878 476C916 434 980 412 1040 406 1110 400 1160 418 1200 428V640Z" fill="#1e1b24"></path>
  <polygon points="1020,408 1060,408 1053,300 1027,300" fill="#f4ebdd"></polygon>
  <polygon points="1023,360 1057,360 1056,346 1024,346" fill="#c4553b"></polygon>
  <rect x="1034" y="384" width="12" height="24" rx="2" fill="#1e1b24"></rect>
  <rect x="1016" y="292" width="48" height="8" fill="#1e1b24"></rect>
  <circle cx="1040" cy="277" r="34" fill="#f6c47e" opacity="0.3"></circle>
  <rect x="1026" y="262" width="28" height="30" fill="#f6c47e"></rect>
  <path d="M1033 262V292M1047 262V292" stroke="#1e1b24" stroke-width="2"></path>
  <path d="M1020 262 1040 242 1060 262Z" fill="#1e1b24"></path>
</svg>
