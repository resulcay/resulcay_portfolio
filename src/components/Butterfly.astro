---
import { BUTTERFLY_ART } from './butterfly-art';

interface Props {
  size?: number;
  label?: string;
  class?: string;
}
const { size = 32, label, class: className } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={Math.round(size * 0.8)}
  viewBox="-22 -18 44 36"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={BUTTERFLY_ART}
></svg>
