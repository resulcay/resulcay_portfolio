---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
{/* Story mode's title art: a 2.5D storm drawn on a canvas, filling its box. */}
<canvas class={className} data-storm aria-hidden="true"></canvas>

<script>
  import { mountStorm, mountStormSound } from '@/scripts/storm';
  import roarUrl from '@/assets/tornado.mp3?url';

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-storm]').forEach(mountStorm);
  const toggle = document.querySelector<HTMLButtonElement>('[data-storm-sound]');
  if (toggle) mountStormSound(roarUrl, toggle);
</script>
