---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
{/* Story mode's title art: a 2.5D storm drawn on a canvas, filling its box. */}
<canvas class={className} data-storm aria-hidden="true"></canvas>

<script>
  import { mountStorm, mountStormSound } from '@/scripts/storm';
  import roarUrl from '@/assets/tornado.mp3?url';

  const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-storm]');
  const cv = document.querySelector<HTMLAnchorElement>('[data-cv-hit]');
  if (canvas) {
    const hit = mountStorm(canvas);
    let struck = false;
    // With the first tap or key, as the roar starts, the storm swells and lightning breaks Download CV.
    const strikeCv = () => {
      if (struck || !cv || document.documentElement.classList.contains('story-open')) return;
      struck = true;
      cv.classList.add('is-bracing');
      const box = canvas.getBoundingClientRect();
      const at = cv.getBoundingClientRect();
      hit(at.left + at.width / 2 - box.left, at.top + at.height / 2 - box.top, () => {
        cv.classList.replace('is-bracing', 'is-broken');
        // Two jagged halves drawn over the link, which stays whole underneath and still downloads.
        for (const side of ['left', 'right']) {
          const half = document.createElement('span');
          half.className = `cv-half cv-half--${side}`;
          half.setAttribute('aria-hidden', 'true');
          half.textContent = cv.textContent;
          cv.appendChild(half);
        }
        shatter(cv.getBoundingClientRect());
      });
    };
    addEventListener('pointerdown', strikeCv, { once: true });
    addEventListener('keydown', strikeCv, { once: true });
  }

  /** Throws fragments off the broken button. */
  function shatter(at: DOMRect) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    for (let i = 0; i < 20; i++) {
      const shard = document.createElement('span');
      const size = 5 + Math.random() * 12;
      shard.className = 'cv-shard';
      shard.style.left = `${at.left + at.width * (0.35 + Math.random() * 0.6)}px`;
      shard.style.top = `${at.top + Math.random() * at.height}px`;
      shard.style.width = `${size}px`;
      shard.style.height = `${size * (0.4 + Math.random() * 0.6)}px`;
      shard.style.setProperty('--dx', `${40 + Math.random() * 160}px`);
      shard.style.setProperty('--dy', `${-60 + Math.random() * 180}px`);
      shard.style.setProperty('--r', `${Math.random() * 720 - 360}deg`);
      shard.addEventListener('animationend', () => shard.remove());
      document.body.appendChild(shard);
    }
  }
  const toggle = document.querySelector<HTMLButtonElement>('[data-storm-sound]');
  if (toggle) mountStormSound(roarUrl, toggle);
</script>
