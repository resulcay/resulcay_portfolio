---
import '@/styles/global.css';
import '@/styles/admin.css';
import LogoMark from '@/components/LogoMark.astro';
import { content } from '@/lib/content';
import { settings } from '@/lib/env';

interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/admin', label: 'Overview' },
  { href: '/admin/projects', label: 'Projects' },
  { href: '/admin/profile', label: 'Profile' },
  { href: '/admin/experience', label: 'Experience' },
  { href: '/admin/testimonials', label: 'Testimonials' },
  { href: '/admin/music', label: 'Music' },
  { href: '/admin/files', label: 'Files' },
  { href: '/admin/messages', label: 'Messages' },
];
const current = (href: string) => (href === '/admin' ? path === '/admin' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="admin">
    <header class="admin-bar">
      <a class="admin-bar__brand" href="/admin"><LogoMark size={28} /> Admin</a>
      <nav aria-label="Admin">
        {nav.map((item) => <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>)}
      </nav>
      <div class="admin-bar__end">
        <a href="/" target="_blank" rel="noopener">View site</a>
        <button type="button" class="button button--small" data-logout>Log out</button>
      </div>
    </header>
    <main id="main" class="admin-main">
      {
        !content.writable && (
          <p class="notice notice--warn">Firebase isn't configured, so changes can't be saved. The site is showing the starter content from the code.</p>
        )
      }
      {
        import.meta.env.DEV && !settings.firebase && (
          <p class="notice">Local mode: changes are kept in memory until the dev server restarts.</p>
        )
      }
      <h1>{title}</h1>
      <slot />
    </main>
    <script>
      import { postJson } from '@/scripts/forms';
      document.querySelector('[data-logout]')?.addEventListener('click', async () => {
        await postJson('/api/admin/logout', {});
        window.location.assign('/');
      });
    </script>
  </body>
</html>
