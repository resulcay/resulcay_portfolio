---
import '@/styles/global.css';
import '@/styles/cursors.css';
import handFont from '@/assets/fonts/dudu-calligraphy.woff2?url';
import bodyFont from '@fontsource/nunito/files/nunito-latin-400-normal.woff2?url';
import Butterfly from '@/components/Butterfly.astro';
import type { Locale } from '@/domain/schemas';
import { localizePath, t } from '@/i18n/ui';
import TopBar from '@/components/TopBar.astro';
import Footer from '@/components/Footer.astro';
import { content } from '@/lib/content';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  ogType?: 'website' | 'profile' | 'article';
  /** Site-relative path of the link preview image. */
  ogImage?: string | undefined;
}

const { lang, title, description, jsonLd, noindex = false, ogType = 'website', ogImage } = Astro.props;
const [profile, music] = await Promise.all([content.getProfile(), content.listMusic()]);
const site = Astro.site ?? new URL('https://resulcay.com');
// After a rewrite (e.g. to the 404 page) keep the address the visitor asked
// for, so an admin URL and any other missing URL render byte for byte alike.
const path = Astro.originPathname;
const canonical = new URL(path, site).href;
const alternates = (['en', 'tr'] as const).map((l) => ({ lang: l, href: new URL(localizePath(path, l), site).href }));
const fullTitle = path === '/' || path === '/tr' ? `${profile.name} · ${profile.title[lang]}` : `${title} · ${profile.name}`;
// JSON-LD is data, not script. Escape "<" so content can never close the tag.
const ld = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={handFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    {/* Holds the page back until its fonts are in (see the veil script below); without JS it never runs. */}
    <script is:inline>document.documentElement.classList.add('loading');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
          <link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />
        </>
      )
    }
    <meta name="theme-color" content="#f4ebdd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1e1b24" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'tr_TR'} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, site).href} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {ld && <script type="application/ld+json" set:html={ld} />}
  </head>
  <body>
    <div class="veil" role="status">
      <Butterfly size={64} class="veil__butterfly" />
      <span class="visually-hidden">{t(lang, 'loading')}</span>
    </div>
    <TopBar lang={lang} path={path} cvPath={profile.cvPath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} profile={profile} hasMusic={music.length > 0} />
    <script>
      import { settleWithin } from '@/scripts/ready';

      // Show the page once its fonts are in, so text never flashes in a fallback face. The veil
      // only appears if that takes longer than 150 ms (see .veil); at most 3 s, then the page shows.
      const root = document.documentElement;
      const veil = document.querySelector<HTMLElement>('.veil');
      const faces = ['500 1em "Dudu Calligraphy"', '400 1em Nunito', '700 1em Nunito'];
      void settleWithin(Promise.all(faces.map((face) => document.fonts.load(face))).then(() => document.fonts.ready), 3000).then(() => {
        if (!veil || getComputedStyle(veil).opacity === '0') return root.classList.remove('loading');
        root.classList.add('loaded');
        setTimeout(() => root.classList.remove('loading', 'loaded'), 400);
      });
    </script>
  </body>
</html>
