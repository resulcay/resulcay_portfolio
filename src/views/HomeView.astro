---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PolaroidCard from '@/components/PolaroidCard.astro';
import Butterfly from '@/components/Butterfly.astro';
import SunsetScene from '@/components/SunsetScene.astro';
import LighthouseScene from '@/components/LighthouseScene.astro';
import type { Locale } from '@/domain/schemas';
import { featuredProjects, publicProjects } from '@/application/content';
import { experienceMonths, latestRole, storeApps, topTech } from '@/application/glance';
import TagChips from '@/components/TagChips.astro';
import { content } from '@/lib/content';
import { personLd } from '@/lib/structured-data';
import { formatPeriod, formatYearMonth, localizePath, t } from '@/i18n/ui';
import { latestArticles } from '@/infrastructure/medium';
import { turnstileSiteKey } from '@/lib/auth';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const [profile, projects, experience, testimonials] = await Promise.all([
  content.getProfile(),
  content.listProjects(),
  content.listExperience(),
  content.listTestimonials(),
]);
// Medium needs the profile's link; an unreachable feed just leaves the section out.
const articles = await latestArticles(profile.links.medium);
const featured = featuredProjects(projects);
const school = profile.education.find((e) => !e.completed);
const latest = latestRole(experience);
const stack = topTech(projects, 8);
// Only facts the content backs; a zero count is left out rather than shown.
const stats = [
  { value: `${Math.floor(experienceMonths(experience, new Date()) / 12)}+`, label: t(lang, 'glance.years') },
  { value: String(publicProjects(projects).length), label: t(lang, 'glance.projects') },
  { value: String(storeApps(projects)), label: t(lang, 'glance.storeApps') },
  { value: String(testimonials.length), label: t(lang, 'glance.testimonials') },
].filter((s) => s.value !== '0' && s.value !== '0+');
const siteKey = turnstileSiteKey();
const phoneDisplay = profile.phone.replace(/^\+90(\d{3})(\d{3})(\d{2})(\d{2})$/, '+90 $1 $2 $3 $4');
---
<BaseLayout
  lang={lang}
  title={profile.name}
  description={`${profile.name}, ${profile.title[lang]}, ${profile.location[lang]}. ${profile.availability[lang]}`}
  jsonLd={personLd(profile, lang)}
  ogType="profile"
>
  <section class="hero wrap" aria-labelledby="hero-title">
    <p class="hand hero__kicker">{t(lang, 'home.kicker')}: {t(lang, 'home.title')}</p>
    <h1 id="hero-title">{profile.name}</h1>
    <p class="hero__role">{profile.title[lang]} · {profile.location[lang]}</p>
    <p class="hero__summary">{profile.summary[lang]}</p>
    <div class="hero__actions">
      <a class="button button--primary" href={profile.cvPath} download>{t(lang, 'nav.cv')}</a>
      <a class="button" href="#contact">{t(lang, 'nav.contact')}</a>
    </div>
  </section>

  <section class="wrap teaser" aria-labelledby="teaser-title">
    <div class="teaser__card">
      <SunsetScene class="teaser__scene" />
      <div class="teaser__text">
        <p class="hand teaser__kicker">{t(lang, 'home.kicker')} · {t(lang, 'home.title')}</p>
        <h2 id="teaser-title">{t(lang, 'teaser.title')}</h2>
        <p>{t(lang, 'teaser.desc')}</p>
        <a class="button button--primary teaser__cta" href={localizePath('/story', lang)}>
          <Butterfly size={18} />
          {t(lang, 'teaser.cta')}
        </a>
      </div>
    </div>
  </section>

  <section class="wrap facts" aria-labelledby="facts-title">
    <svg class="clip-defs" aria-hidden="true">
      <symbol id="binder-clip" viewBox="0 0 40 40">
        <path d="M11 19 7 3h26l-4 16" fill="none" stroke="#c9ced6" stroke-width="2.2" stroke-linejoin="round" />
        <path d="M5 19h30l-3 18H8Z" fill="#1d1c22" />
        <path d="M6 20.5h28" stroke="#4a4852" stroke-width="1.5" />
      </symbol>
      <symbol id="paper-clip" viewBox="0 0 16 44">
        <path d="M11 14v19a4 4 0 0 1-8 0V9a5.5 5.5 0 0 1 11 0v25" fill="none" stroke="#b9bfc8" stroke-width="1.8" stroke-linecap="round" />
      </symbol>
    </svg>
    <div class="spread">
      <svg class="clip" aria-hidden="true"><use href="#binder-clip" /></svg>
      <div class="page page--left">
        <h2 id="facts-title" class="page__title">{t(lang, 'home.facts')}</h2>
          <dl class="notebook">
            <div>
              <dt>{t(lang, 'facts.role')}</dt>
              <dd>{profile.title[lang]} · {profile.location[lang]}</dd>
            </div>
            {
              latest && (
                <div>
                  <dt>{t(lang, 'facts.lately')}</dt>
                  <dd>
                    {latest.title[lang]}, {latest.organization} ({formatPeriod(latest.start, latest.end, lang)})
                  </dd>
                </div>
              )
            }
            {
              stack.length > 0 && (
                <div>
                  <dt>{t(lang, 'facts.stack')}</dt>
                  <dd>
                    <TagChips tags={stack} lang={lang} />
                  </dd>
                </div>
              )
            }
            {
              school && (
                <div>
                  <dt>{t(lang, 'facts.studied')}</dt>
                  <dd>
                    {school.school}, {school.program[lang]}, {school.start}–{school.end} ({t(lang, 'facts.notCompleted')})
                  </dd>
                </div>
              )
            }
            <div>
              <dt>{t(lang, 'facts.availability')}</dt>
              <dd>{profile.availability[lang]}</dd>
            </div>
          </dl>
      </div>
      <div class="page page--right">
          <ul class="glance">
            {
              stats.map((s) => (
                <li>
                  <svg class="paperclip" aria-hidden="true"><use href="#paper-clip" /></svg>
                  <span class="glance__value">{s.value}</span>
                  <span class="glance__label">{s.label}</span>
                </li>
              ))
            }
          </ul>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="featured-title">
    <div class="section__head">
      <h2 id="featured-title">{t(lang, 'home.featured')}</h2>
      <a href={localizePath('/projects', lang)}>{t(lang, 'home.allProjects')}</a>
    </div>
    <div class="corkboard">
      <div class="grid">
        {featured.map((project, i) => <PolaroidCard project={project} lang={lang} index={i} />)}
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="experience-title">
    <h2 id="experience-title">{t(lang, 'home.experience')}</h2>
    <ol class="timeline">
      {
        experience.map((job) => (
          <li>
            <p class="timeline__when">{formatPeriod(job.start, job.end, lang)}</p>
            <div class="timeline__body">
              <h3>{job.title[lang]}</h3>
              <p class="timeline__org">{job.organization} · {job.location}</p>
              {job.points.length > 0 && (
                <ul>
                  {job.points.slice(0, 3).map((point) => (
                    <li>{point[lang]}</li>
                  ))}
                </ul>
              )}
              {job.points.length > 3 && (
                <details>
                  <summary>{t(lang, 'experience.more')}</summary>
                  <ul>
                    {job.points.slice(3).map((point) => (
                      <li>{point[lang]}</li>
                    ))}
                  </ul>
                </details>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {
    articles.length > 0 && (
      <section class="wrap section" aria-labelledby="writing-title">
        <div class="lighthouse">
          <LighthouseScene class="lighthouse__scene" />
          <div class="section__head lighthouse__head">
            <h2 id="writing-title">{t(lang, 'home.writing')}</h2>
            <a href={profile.links.medium} rel="me">
              {t(lang, 'home.allArticles')}
            </a>
          </div>
          <ul class="articles">
          {articles.map((article) => (
            <li class="article">
              <p class="article__when">{formatYearMonth(article.date.slice(0, 7), lang)}</p>
              <h3>
                <a href={article.url}>{article.title}</a>
              </h3>
              {article.summary && <p class="article__summary">{article.summary}</p>}
              <TagChips tags={article.tags.slice(0, 3)} lang={lang} />
            </li>
          ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="wrap section" aria-labelledby="testimonials-title">
    <h2 id="testimonials-title">{t(lang, 'home.testimonials')}</h2>
    <div class="quotes">
      {
        testimonials.map((item) => (
          <figure>
            <blockquote>{item.quote[lang]}</blockquote>
            <figcaption class="hand">{item.name}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section id="contact" class="wrap section contact" aria-labelledby="contact-title">
    <h2 id="contact-title">{t(lang, 'contact.title')}</h2>
    <div class="phone">
      <div class="phone__screen">
        <div class="phone__status" aria-hidden="true">
          <span data-phone-clock></span>
          <span class="phone__icons">
            <svg viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1" /><rect x="5" y="5.5" width="3" height="6.5" rx="1" /><rect x="10" y="3" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="12" rx="1" /></svg>
            <svg viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M1 4.5a10 10 0 0 1 14 0M3.6 7.2a6.2 6.2 0 0 1 8.8 0" /><circle cx="8" cy="10" r="1.2" fill="currentColor" stroke="none" /></svg>
            <svg viewBox="0 0 26 12"><rect x="0.75" y="0.75" width="21.5" height="10.5" rx="3" fill="none" stroke="currentColor" stroke-width="1.5" /><rect x="3" y="3" width="13" height="6" rx="1.5" /><rect x="23.5" y="4" width="2" height="4" rx="1" /></svg>
          </span>
        </div>
        <div class="phone__bar">
          <Butterfly size={22} />
          <span>{profile.name}</span>
        </div>
        <div class="phone__chat">
          <p class="phone__bubble">{t(lang, 'contact.intro')} {profile.availability[lang]}</p>
          {
            siteKey && (
              <form class="contact-form" data-contact novalidate>
                <h3>{t(lang, 'contact.formTitle')}</h3>
                <div class="contact-form__row">
                  <label>
                    <span>{t(lang, 'contact.name')}</span>
                    <input name="name" autocomplete="name" required maxlength="80" />
                    <small data-error-for="name" />
                  </label>
                  <label>
                    <span>{t(lang, 'contact.yourEmail')}</span>
                    <input name="email" type="email" autocomplete="email" required maxlength="120" />
                    <small data-error-for="email" />
                  </label>
                </div>
                <label>
                  <span>{t(lang, 'contact.message')}</span>
                  <textarea name="message" rows="2" required minlength="10" maxlength="4000" />
                  <small data-error-for="message" />
                </label>
                <label class="visually-hidden" aria-hidden="true">
                  Website
                  <input name="website" tabindex="-1" autocomplete="off" />
                </label>
                <input type="hidden" name="lang" value={lang} />
                <div data-turnstile data-sitekey={siteKey} />
                <p class="contact-form__note">{t(lang, 'contact.privacy')}</p>
                <p role="status" aria-live="polite" />
                <div>
                  <button type="submit" class="button button--primary">{t(lang, 'contact.send')}</button>
                </div>
                <template data-messages>
                  <span data-key="sending">{t(lang, 'contact.sending')}</span>
                  <span data-key="sent">{t(lang, 'contact.sent')}</span>
                  <span data-key="human">{t(lang, 'contact.humanWait')}</span>
                  <span data-key="human-failed">{t(lang, 'contact.humanFailed')}</span>
                  <span data-key="failed">{t(lang, 'contact.failed')}</span>
                  <span data-key="field-name">{t(lang, 'contact.errName')}</span>
                  <span data-key="field-email">{t(lang, 'contact.errEmail')}</span>
                  <span data-key="field-message">{t(lang, 'contact.errMessage')}</span>
                </template>
              </form>
            )
          }
        </div>
        <div class="phone__contacts">
          <dl>
            <div><dt>{t(lang, 'contact.email')}</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd></div>
            <div><dt>{t(lang, 'contact.phone')}</dt><dd><a href={`tel:${profile.phone}`}>{phoneDisplay}</a></dd></div>
            <div><dt>LinkedIn</dt><dd><a href={profile.links.linkedin} rel="me">linkedin.com/in/resulcay</a></dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // The contact phone's clock shows the visitor's own time, set after load so the server's never shows.
  const clock = document.querySelector<HTMLElement>('[data-phone-clock]');
  const tick = () => {
    if (clock) clock.textContent = new Date().toLocaleTimeString(document.documentElement.lang, { hour: '2-digit', minute: '2-digit' });
  };
  tick();
  setInterval(tick, 30_000);

  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) {
    // Validation loads the first time someone starts typing, and the human
    // check only when they press Send, so the page itself stays light.
    const start = () => void import('@/scripts/contact-form').then(({ setUpContactForm }) => setUpContactForm(form));
    form.addEventListener('focusin', start, { once: true });
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-block: clamp(48px, 9vw, 112px) 40px;
  }
  .hero__kicker {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .hero h1 {
    font-size: clamp(3rem, 9vw, 6.5rem);
    letter-spacing: -0.01em;
  }
  .hero__role {
    font-size: 1.25rem;
    font-weight: 700;
  }
  .hero__summary {
    max-width: var(--measure);
    font-size: 1.125rem;
    color: var(--ink-quiet);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 10px;
  }
  .hero :global(.hero__butterfly) {
    position: absolute;
    right: 4%;
    top: 22%;
    animation: drift 7s ease-in-out infinite alternate;
  }
  @media (max-width: 640px) {
    .hero :global(.hero__butterfly) {
      top: 40px;
      right: 0;
    }
  }
  @keyframes drift {
    from {
      transform: translate(0, 0) rotate(0deg);
    }
    to {
      transform: translate(-18px, 14px) rotate(-8deg);
    }
  }
  /* The way into Story mode: its title art as a banner, the text over the darker left. */
  .teaser {
    padding-top: 8px;
  }
  .teaser__card {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 280px;
    overflow: hidden;
    border-radius: var(--radius);
    color: #f4ebdd;
    box-shadow: 0 14px 30px -14px rgb(0 0 0 / 0.35);
  }
  .teaser__card :global(.teaser__scene) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .teaser__card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(30 27 36 / 0.7), rgb(30 27 36 / 0.3) 50%, transparent 75%);
  }
  .teaser__text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    max-width: 30rem;
    padding: clamp(24px, 5vw, 48px);
  }
  .teaser__text h2 {
    margin: 0;
    color: #f4ebdd;
  }
  .teaser__text p {
    margin: 0;
    color: #ede3d2;
  }
  .teaser__kicker {
    font-size: 1.4rem;
    color: #e8a657 !important;
  }
  .teaser__cta {
    margin-top: 6px;
  }
  .facts {
    padding: 32px 0;
  }
  /* "At a glance" as an open notebook: two ruled pages meeting at the spine,
     clipped along their outer edges. On narrow screens it folds to one page. */
  .spread {
    --line: 2rem;
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-radius: 10px;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.08),
      0 14px 30px -12px rgb(0 0 0 / 0.3);
  }
  .page {
    --margin: 3rem;
    position: relative;
    padding: var(--line) 28px var(--line) calc(var(--margin) + 14px);
    background-color: var(--paper-raised);
    background-image:
      linear-gradient(to right, transparent var(--margin), rgb(217 83 79 / 0.45) var(--margin) calc(var(--margin) + 1.5px), transparent calc(var(--margin) + 1.5px)),
      repeating-linear-gradient(to bottom, transparent 0 calc(var(--line) - 1px), color-mix(in srgb, var(--rule) 70%, transparent) calc(var(--line) - 1px) var(--line));
  }
  .page--left {
    --margin: calc(28px + 6.5rem + 6px);
    padding-left: 28px;
    border-radius: 10px 0 0 10px;
    /* The page darkens a little as it curves into the spine. */
    box-shadow: inset -24px 0 24px -20px rgb(0 0 0 / 0.25);
  }
  .page--right {
    border-radius: 0 10px 10px 0;
    box-shadow: inset 24px 0 24px -20px rgb(0 0 0 / 0.25);
  }
  /* One binder clip holding the notebook by its left edge, and a paper clip on each sticky note. */
  .clip-defs {
    position: absolute;
    width: 0;
    height: 0;
  }
  .clip {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: -20px;
    width: 40px;
    height: 40px;
    translate: 0 -50%;
    rotate: -90deg;
    filter: drop-shadow(0 2px 2px rgb(0 0 0 / 0.35));
  }
  .paperclip {
    position: absolute;
    top: -14px;
    left: 14px;
    width: 14px;
    height: 38px;
    rotate: -8deg;
    filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.3));
  }
  /* Written like a page heading: just right of the margin line, over the
     notes' column, with an empty ruled line beneath it. */
  .page__title {
    margin: 0 0 var(--line) calc(6.5rem + 12px);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.6rem;
    line-height: var(--line);
    color: var(--ink);
  }
  @media (max-width: 760px) {
    /* The phone's side gutter is 16px; keep the clip's handles on screen. */
    .clip {
      left: -14px;
    }
    .spread {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 12px;
    }
    .page--left,
    .page--right {
      border-radius: 0;
      box-shadow: none;
    }
    .page--left {
      border-radius: 10px 10px 0 0;
    }
    .page--right {
      border-radius: 0 0 10px 10px;
    }
  }
  .notebook {
    margin: 0;
  }
  .notebook > div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    line-height: var(--line);
  }
  .notebook dt {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.2rem;
    color: var(--accent-text);
  }
  .notebook dd {
    margin: 0;
  }
  .notebook dd :global(.chips) {
    padding-block: calc((var(--line) - 1.6rem) / 2);
    row-gap: calc(var(--line) - 1.6rem);
  }
  /* The stats as sticky notes on the right page, each its own muted colour and tilt. */
  .glance {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 4px 0;
    list-style: none;
  }
  .glance li {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 7.5rem;
    padding: 14px 16px;
    border-radius: 3px;
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.08),
      0 6px 10px -6px rgb(0 0 0 / 0.25);
  }
  .glance li:nth-child(4n + 1) {
    background: color-mix(in srgb, var(--golden) 22%, var(--paper-raised));
    rotate: -1.6deg;
  }
  .glance li:nth-child(4n + 2) {
    background: color-mix(in srgb, var(--teal) 18%, var(--paper-raised));
    rotate: 1.2deg;
  }
  .glance li:nth-child(4n + 3) {
    background: color-mix(in srgb, var(--violet) 16%, var(--paper-raised));
    rotate: 0.8deg;
  }
  .glance li:nth-child(4n + 4) {
    background: color-mix(in srgb, var(--butterfly) 18%, var(--paper-raised));
    rotate: -1deg;
  }
  .glance__value {
    font-family: var(--font-display);
    font-size: 2.6rem;
    line-height: 1;
    color: var(--accent-text);
  }
  .glance__label {
    color: var(--ink);
    font-size: 0.9rem;
    line-height: 1.35;
    text-wrap: balance;
  }
  /* A gentle rise as the facts scroll in; anything already in view is shown as is. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .glance li,
      .notebook > div {
        animation: glance-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
    }
  }
  @keyframes glance-rise {
    from {
      opacity: 0.3;
      transform: translateY(12px);
    }
  }
  .contact dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px 32px;
    margin: 12px 0 0;
  }
  dt {
    font-weight: 700;
  }
  dd {
    margin: 0;
    color: var(--ink-quiet);
  }
  .section {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-top: 88px;
  }
  .section h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
  }
  .section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .section__head a {
    font-weight: 700;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 40px 32px;
  }
  /* The featured projects pinned to a cork board in a wooden frame, held by
     pushpins and strips of tape in turn. */
  .corkboard {
    padding: clamp(28px, 4vw, 48px) clamp(18px, 3vw, 40px);
    border: 12px solid #6b4a2f;
    border-radius: 14px;
    background-color: #b98a5a;
    background-image:
      radial-gradient(rgb(90 60 30 / 0.35) 1px, transparent 1.6px),
