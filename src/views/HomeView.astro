---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PolaroidCard from '@/components/PolaroidCard.astro';
import Butterfly from '@/components/Butterfly.astro';
import type { Locale } from '@/domain/schemas';
import { featuredProjects, publicProjects } from '@/application/content';
import { experienceMonths, latestRole, storeApps, topTech } from '@/application/glance';
import TagChips from '@/components/TagChips.astro';
import { content } from '@/lib/content';
import { personLd } from '@/lib/structured-data';
import { formatPeriod, localizePath, t } from '@/i18n/ui';
import { turnstileSiteKey } from '@/lib/auth';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const [profile, projects, experience, testimonials] = await Promise.all([
  content.getProfile(),
  content.listProjects(),
  content.listExperience(),
  content.listTestimonials(),
]);
const featured = featuredProjects(projects);
const school = profile.education.find((e) => !e.completed);
const latest = latestRole(experience);
const stack = topTech(projects, 8);
// Only facts the content backs; a zero count is left out rather than shown.
const stats = [
  { value: `${Math.floor(experienceMonths(experience, new Date()) / 12)}+`, label: t(lang, 'glance.years') },
  { value: String(publicProjects(projects).length), label: t(lang, 'glance.projects') },
  { value: String(storeApps(projects)), label: t(lang, 'glance.storeApps') },
  { value: String(testimonials.length), label: t(lang, 'glance.testimonials') },
].filter((s) => s.value !== '0' && s.value !== '0+');
const siteKey = turnstileSiteKey();
const phoneDisplay = profile.phone.replace(/^\+90(\d{3})(\d{3})(\d{2})(\d{2})$/, '+90 $1 $2 $3 $4');
---
<BaseLayout
  lang={lang}
  title={profile.name}
  description={`${profile.name}, ${profile.title[lang]}, ${profile.location[lang]}. ${profile.availability[lang]}`}
  jsonLd={personLd(profile, lang)}
  ogType="profile"
>
  <section class="hero wrap" aria-labelledby="hero-title">
    <p class="hand hero__kicker">{t(lang, 'home.kicker')}: {t(lang, 'home.title')}</p>
    <h1 id="hero-title">{profile.name}</h1>
    <p class="hero__role">{profile.title[lang]} · {profile.location[lang]}</p>
    <p class="hero__summary">{profile.summary[lang]}</p>
    <div class="hero__actions">
      <a class="button button--primary" href={profile.cvPath} download>{t(lang, 'nav.cv')}</a>
      <a class="button" href="#contact">{t(lang, 'nav.contact')}</a>
    </div>
    <Butterfly size={44} class="hero__butterfly" />
  </section>

  <section class="wrap facts" aria-labelledby="facts-title">
    <h2 id="facts-title" class="eyebrow">{t(lang, 'home.facts')}</h2>
    <ul class="glance">
      {
        stats.map((s) => (
          <li>
            <span class="glance__value">{s.value}</span>
            <span class="glance__label">{s.label}</span>
          </li>
        ))
      }
    </ul>
    <ul class="facts__chips">
      <li>
        <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="5" width="12" height="8.5" rx="2" /><path d="M5.5 5V3.5h5V5M2 9h12" /></svg>
        {profile.title[lang]}
      </li>
      <li>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 14.5s4.5-4.2 4.5-7.7a4.5 4.5 0 0 0-9 0c0 3.5 4.5 7.7 4.5 7.7Z" /><circle cx="8" cy="6.8" r="1.6" /></svg>
        {profile.location[lang]}
      </li>
      {
        latest && (
          <li title={`${latest.title[lang]}, ${latest.organization} (${formatPeriod(latest.start, latest.end, lang)})`}>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 14V3.5h7V14M10 7h3v7M1.5 14h13M5.5 6h2M5.5 9h2" /></svg>
            <span>
              {latest.title[lang]} @ {latest.organization} · {latest.start.slice(0, 4)}–{latest.end?.slice(2, 4) ?? ''}
            </span>
          </li>
        )
      }
      {
        school && (
          <li title={`${school.school}, ${school.program[lang]}, ${school.start}–${school.end} (${t(lang, 'facts.notCompleted')})`}>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 6.5 8 3.5l6.5 3L8 9.5Z" /><path d="M4.5 8v3.2c1.9 1.6 5.1 1.6 7 0V8" /></svg>
            <span>
              {school.school}, {school.program[lang]} · {t(lang, 'facts.notCompleted')}
            </span>
          </li>
        )
      }
      <li class="facts__open">
        <span class="facts__dot" aria-hidden="true"></span>
        {profile.availability[lang]}
      </li>
    </ul>
    {
      stack.length > 0 && (
        <div class="facts__stack">
          <span class="facts__label">{t(lang, 'facts.stack')}</span>
          <TagChips tags={stack} lang={lang} />
        </div>
      )
    }
  </section>

  <section class="wrap section" aria-labelledby="featured-title">
    <div class="section__head">
      <h2 id="featured-title">{t(lang, 'home.featured')}</h2>
      <a href={localizePath('/projects', lang)}>{t(lang, 'home.allProjects')}</a>
    </div>
    <div class="grid">
      {featured.map((project, i) => <PolaroidCard project={project} lang={lang} index={i} />)}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="experience-title">
    <h2 id="experience-title">{t(lang, 'home.experience')}</h2>
    <ol class="timeline">
      {
        experience.map((job) => (
          <li>
            <p class="timeline__when">{formatPeriod(job.start, job.end, lang)}</p>
            <div class="timeline__body">
              <h3>{job.title[lang]}</h3>
              <p class="timeline__org">{job.organization} · {job.location}</p>
              {job.points.length > 0 && (
                <ul>
                  {job.points.map((point) => (
                    <li>{point[lang]}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap section" aria-labelledby="testimonials-title">
    <h2 id="testimonials-title">{t(lang, 'home.testimonials')}</h2>
    <div class="quotes">
      {
        testimonials.map((item) => (
          <figure>
            <blockquote>{item.quote[lang]}</blockquote>
            <figcaption class="hand">{item.name}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section id="contact" class="wrap section contact" aria-labelledby="contact-title">
    <h2 id="contact-title">{t(lang, 'contact.title')}</h2>
    <p>{t(lang, 'contact.intro')} {profile.availability[lang]}</p>
    <dl>
      <div><dt>{t(lang, 'contact.email')}</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd></div>
      <div><dt>{t(lang, 'contact.phone')}</dt><dd><a href={`tel:${profile.phone}`}>{phoneDisplay}</a></dd></div>
      <div><dt>LinkedIn</dt><dd><a href={profile.links.linkedin} rel="me">linkedin.com/in/resulcay</a></dd></div>
    </dl>
    {
      siteKey && (
        <form class="contact-form" data-contact novalidate>
          <h3>{t(lang, 'contact.formTitle')}</h3>
          <div class="contact-form__row">
            <label>
              <span>{t(lang, 'contact.name')}</span>
              <input name="name" autocomplete="name" required maxlength="80" />
              <small data-error-for="name" />
            </label>
            <label>
              <span>{t(lang, 'contact.yourEmail')}</span>
              <input name="email" type="email" autocomplete="email" required maxlength="120" />
              <small data-error-for="email" />
            </label>
          </div>
          <label>
            <span>{t(lang, 'contact.message')}</span>
            <textarea name="message" rows="6" required minlength="10" maxlength="4000" />
            <small data-error-for="message" />
          </label>
          <label class="visually-hidden" aria-hidden="true">
            Website
            <input name="website" tabindex="-1" autocomplete="off" />
          </label>
          <input type="hidden" name="lang" value={lang} />
          <div data-turnstile data-sitekey={siteKey} />
          <p class="contact-form__note">{t(lang, 'contact.privacy')}</p>
          <p role="status" aria-live="polite" />
          <div>
            <button type="submit" class="button button--primary">{t(lang, 'contact.send')}</button>
          </div>
          <template data-messages>
            <span data-key="sending">{t(lang, 'contact.sending')}</span>
            <span data-key="sent">{t(lang, 'contact.sent')}</span>
            <span data-key="human">{t(lang, 'contact.humanWait')}</span>
            <span data-key="human-failed">{t(lang, 'contact.humanFailed')}</span>
            <span data-key="failed">{t(lang, 'contact.failed')}</span>
            <span data-key="field-name">{t(lang, 'contact.errName')}</span>
            <span data-key="field-email">{t(lang, 'contact.errEmail')}</span>
            <span data-key="field-message">{t(lang, 'contact.errMessage')}</span>
          </template>
        </form>
      )
    }
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) {
    // Validation loads the first time someone starts typing, and the human
    // check only when they press Send, so the page itself stays light.
    const start = () => void import('@/scripts/contact-form').then(({ setUpContactForm }) => setUpContactForm(form));
    form.addEventListener('focusin', start, { once: true });
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-block: clamp(48px, 9vw, 112px) 40px;
  }
  .hero__kicker {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .hero h1 {
    font-size: clamp(3rem, 9vw, 6.5rem);
    letter-spacing: -0.01em;
  }
  .hero__role {
    font-size: 1.25rem;
    font-weight: 700;
  }
  .hero__summary {
    max-width: var(--measure);
    font-size: 1.125rem;
    color: var(--ink-quiet);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 10px;
  }
  .hero :global(.hero__butterfly) {
    position: absolute;
    right: 4%;
    top: 22%;
    animation: drift 7s ease-in-out infinite alternate;
  }
  @media (max-width: 640px) {
    .hero :global(.hero__butterfly) {
      top: 40px;
      right: 0;
    }
  }
  @keyframes drift {
    from {
      transform: translate(0, 0) rotate(0deg);
    }
    to {
      transform: translate(-18px, 14px) rotate(-8deg);
    }
  }
  .facts {
    padding: 24px 0;
    border-block: 1px solid var(--rule);
  }
  .glance {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
    margin: 16px 0 8px;
    padding: 0;
    list-style: none;
  }
  .glance li {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 10px 14px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .glance__value {
    font-family: var(--font-display);
    font-size: 2.1rem;
    line-height: 1;
    color: var(--accent-text);
  }
  .glance__label {
    color: var(--ink-quiet);
    font-size: 0.9rem;
    line-height: 1.35;
    text-wrap: balance;
  }
  .facts__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }
  .facts__chips li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: 100%;
    padding: 4px 12px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .facts__chips li span:not([aria-hidden]) {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .facts__chips svg {
    flex: none;
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .facts__open {
    border-color: var(--golden) !important;
    color: var(--accent-text);
  }
  .facts__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--golden);
  }
  .facts__stack {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 14px;
  }
  .facts__label {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--ink-quiet);
  }
  /* A gentle rise as the facts scroll in; anything already in view is shown as is. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .glance li,
      .facts__chips li {
        animation: glance-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
    }
  }
  @keyframes glance-rise {
    from {
      opacity: 0.3;
      transform: translateY(12px);
    }
  }
  .contact dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px 32px;
    margin: 12px 0 0;
  }
  dt {
    font-weight: 700;
  }
  dd {
    margin: 0;
    color: var(--ink-quiet);
  }
  .section {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-top: 88px;
  }
  .section h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
  }
  .section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .section__head a {
    font-weight: 700;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 40px 32px;
  }
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .timeline > li {
    display: grid;
    grid-template-columns: minmax(0, 180px) minmax(0, 1fr);
    gap: 8px 32px;
  }
  .timeline__when {
    font-weight: 700;
    color: var(--accent-text);
  }
  .timeline__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .timeline h3 {
    font-size: 1.5rem;
  }
  .timeline__org {
    color: var(--ink-quiet);
  }
  .timeline ul {
    margin: 6px 0 0;
    padding-left: 20px;
    max-width: var(--measure);
  }
  @media (max-width: 640px) {
    .timeline > li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }
  figure {
    margin: 0;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--paper-raised);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  blockquote {
    margin: 0;
  }
  figcaption {
    font-size: 1.5rem;
  }
  .contact p {
    max-width: var(--measure);
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 720px;
    margin-top: 16px;
    padding: clamp(20px, 4vw, 32px);
    border-radius: var(--radius);
    background: var(--paper-raised);
  }
  .contact-form h3 {
    font-size: 1.5rem;
  }
  .contact-form__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }
  .contact-form label:not(.visually-hidden) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-weight: 700;
  }
  .contact-form input,
  .contact-form textarea {
    min-height: 48px;
    padding: 10px 12px;
    border: 1.5px solid var(--rule);
    border-radius: 8px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-weight: 400;
  }
  .contact-form textarea {
    resize: vertical;
  }
  .contact-form [aria-invalid='true'] {
    border-color: #b3261e;
  }
  .contact-form small {
    color: var(--accent-text);
    font-weight: 400;
  }
  .contact-form small:empty,
  .contact-form [role='status']:empty {
    display: none;
  }
  .contact-form__note {
    color: var(--ink-quiet);
    font-size: 0.9375rem;
  }
</style>
