---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PolaroidCard from '@/components/PolaroidCard.astro';
import Butterfly from '@/components/Butterfly.astro';
import type { Locale } from '@/domain/schemas';
import { featuredProjects, publicProjects } from '@/application/content';
import { experienceMonths, latestRole, storeApps, topTech } from '@/application/glance';
import TagChips from '@/components/TagChips.astro';
import { content } from '@/lib/content';
import { personLd } from '@/lib/structured-data';
import { formatPeriod, localizePath, t } from '@/i18n/ui';
import { turnstileSiteKey } from '@/lib/auth';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const [profile, projects, experience, testimonials] = await Promise.all([
  content.getProfile(),
  content.listProjects(),
  content.listExperience(),
  content.listTestimonials(),
]);
const featured = featuredProjects(projects);
const school = profile.education.find((e) => !e.completed);
const latest = latestRole(experience);
const stack = topTech(projects, 8);
// Only facts the content backs; a zero count is left out rather than shown.
const stats = [
  { value: `${Math.floor(experienceMonths(experience, new Date()) / 12)}+`, label: t(lang, 'glance.years') },
  { value: String(publicProjects(projects).length), label: t(lang, 'glance.projects') },
  { value: String(storeApps(projects)), label: t(lang, 'glance.storeApps') },
  { value: String(testimonials.length), label: t(lang, 'glance.testimonials') },
].filter((s) => s.value !== '0' && s.value !== '0+');
const siteKey = turnstileSiteKey();
const phoneDisplay = profile.phone.replace(/^\+90(\d{3})(\d{3})(\d{2})(\d{2})$/, '+90 $1 $2 $3 $4');
---
<BaseLayout
  lang={lang}
  title={profile.name}
  description={`${profile.name}, ${profile.title[lang]}, ${profile.location[lang]}. ${profile.availability[lang]}`}
  jsonLd={personLd(profile, lang)}
  ogType="profile"
>
  <section class="hero wrap" aria-labelledby="hero-title">
    <p class="hand hero__kicker">{t(lang, 'home.kicker')}: {t(lang, 'home.title')}</p>
    <h1 id="hero-title">{profile.name}</h1>
    <p class="hero__role">{profile.title[lang]} · {profile.location[lang]}</p>
    <p class="hero__summary">{profile.summary[lang]}</p>
    <div class="hero__actions">
      <a class="button button--primary" href={profile.cvPath} download>{t(lang, 'nav.cv')}</a>
      <a class="button" href="#contact">{t(lang, 'nav.contact')}</a>
    </div>
    <Butterfly size={44} class="hero__butterfly" />
  </section>

  <section class="wrap facts" aria-labelledby="facts-title">
    <div class="spread">
      <div class="page page--left">
        <h2 id="facts-title" class="page__title">{t(lang, 'home.facts')}</h2>
          <dl class="notebook">
            <div>
              <dt>{t(lang, 'facts.role')}</dt>
              <dd>{profile.title[lang]} · {profile.location[lang]}</dd>
            </div>
            {
              latest && (
                <div>
                  <dt>{t(lang, 'facts.lately')}</dt>
                  <dd>
                    {latest.title[lang]}, {latest.organization} ({formatPeriod(latest.start, latest.end, lang)})
                  </dd>
                </div>
              )
            }
            {
              stack.length > 0 && (
                <div>
                  <dt>{t(lang, 'facts.stack')}</dt>
                  <dd>
                    <TagChips tags={stack} lang={lang} />
                  </dd>
                </div>
              )
            }
            {
              school && (
                <div>
                  <dt>{t(lang, 'facts.studied')}</dt>
                  <dd>
                    {school.school}, {school.program[lang]}, {school.start}–{school.end} ({t(lang, 'facts.notCompleted')})
                  </dd>
                </div>
              )
            }
            <div>
              <dt>{t(lang, 'facts.availability')}</dt>
              <dd>{profile.availability[lang]}</dd>
            </div>
          </dl>
      </div>
      <div class="page page--right">
          <ul class="glance">
            {
              stats.map((s) => (
                <li>
                  <span class="glance__value">{s.value}</span>
                  <span class="glance__label">{s.label}</span>
                </li>
              ))
            }
          </ul>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="featured-title">
    <div class="section__head">
      <h2 id="featured-title">{t(lang, 'home.featured')}</h2>
      <a href={localizePath('/projects', lang)}>{t(lang, 'home.allProjects')}</a>
    </div>
    <div class="grid">
      {featured.map((project, i) => <PolaroidCard project={project} lang={lang} index={i} />)}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="experience-title">
    <h2 id="experience-title">{t(lang, 'home.experience')}</h2>
    <ol class="timeline">
      {
        experience.map((job) => (
          <li>
            <p class="timeline__when">{formatPeriod(job.start, job.end, lang)}</p>
            <div class="timeline__body">
              <h3>{job.title[lang]}</h3>
              <p class="timeline__org">{job.organization} · {job.location}</p>
              {job.points.length > 0 && (
                <ul>
                  {job.points.map((point) => (
                    <li>{point[lang]}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap section" aria-labelledby="testimonials-title">
    <h2 id="testimonials-title">{t(lang, 'home.testimonials')}</h2>
    <div class="quotes">
      {
        testimonials.map((item) => (
          <figure>
            <blockquote>{item.quote[lang]}</blockquote>
            <figcaption class="hand">{item.name}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section id="contact" class="wrap section contact" aria-labelledby="contact-title">
    <h2 id="contact-title">{t(lang, 'contact.title')}</h2>
    <p>{t(lang, 'contact.intro')} {profile.availability[lang]}</p>
    <dl>
      <div><dt>{t(lang, 'contact.email')}</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd></div>
      <div><dt>{t(lang, 'contact.phone')}</dt><dd><a href={`tel:${profile.phone}`}>{phoneDisplay}</a></dd></div>
      <div><dt>LinkedIn</dt><dd><a href={profile.links.linkedin} rel="me">linkedin.com/in/resulcay</a></dd></div>
    </dl>
    {
      siteKey && (
        <form class="contact-form" data-contact novalidate>
          <h3>{t(lang, 'contact.formTitle')}</h3>
          <div class="contact-form__row">
            <label>
              <span>{t(lang, 'contact.name')}</span>
              <input name="name" autocomplete="name" required maxlength="80" />
              <small data-error-for="name" />
            </label>
            <label>
              <span>{t(lang, 'contact.yourEmail')}</span>
              <input name="email" type="email" autocomplete="email" required maxlength="120" />
              <small data-error-for="email" />
            </label>
          </div>
          <label>
            <span>{t(lang, 'contact.message')}</span>
            <textarea name="message" rows="6" required minlength="10" maxlength="4000" />
            <small data-error-for="message" />
          </label>
          <label class="visually-hidden" aria-hidden="true">
            Website
            <input name="website" tabindex="-1" autocomplete="off" />
          </label>
          <input type="hidden" name="lang" value={lang} />
          <div data-turnstile data-sitekey={siteKey} />
          <p class="contact-form__note">{t(lang, 'contact.privacy')}</p>
          <p role="status" aria-live="polite" />
          <div>
            <button type="submit" class="button button--primary">{t(lang, 'contact.send')}</button>
          </div>
          <template data-messages>
            <span data-key="sending">{t(lang, 'contact.sending')}</span>
            <span data-key="sent">{t(lang, 'contact.sent')}</span>
            <span data-key="human">{t(lang, 'contact.humanWait')}</span>
            <span data-key="human-failed">{t(lang, 'contact.humanFailed')}</span>
            <span data-key="failed">{t(lang, 'contact.failed')}</span>
            <span data-key="field-name">{t(lang, 'contact.errName')}</span>
            <span data-key="field-email">{t(lang, 'contact.errEmail')}</span>
            <span data-key="field-message">{t(lang, 'contact.errMessage')}</span>
          </template>
        </form>
      )
    }
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) {
    // Validation loads the first time someone starts typing, and the human
    // check only when they press Send, so the page itself stays light.
    const start = () => void import('@/scripts/contact-form').then(({ setUpContactForm }) => setUpContactForm(form));
    form.addEventListener('focusin', start, { once: true });
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-block: clamp(48px, 9vw, 112px) 40px;
  }
  .hero__kicker {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .hero h1 {
    font-size: clamp(3rem, 9vw, 6.5rem);
    letter-spacing: -0.01em;
  }
  .hero__role {
    font-size: 1.25rem;
    font-weight: 700;
  }
  .hero__summary {
    max-width: var(--measure);
    font-size: 1.125rem;
    color: var(--ink-quiet);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 10px;
  }
  .hero :global(.hero__butterfly) {
    position: absolute;
    right: 4%;
    top: 22%;
    animation: drift 7s ease-in-out infinite alternate;
  }
  @media (max-width: 640px) {
    .hero :global(.hero__butterfly) {
      top: 40px;
      right: 0;
    }
  }
  @keyframes drift {
    from {
      transform: translate(0, 0) rotate(0deg);
    }
    to {
      transform: translate(-18px, 14px) rotate(-8deg);
    }
  }
  .facts {
    padding: 32px 0;
  }
  /* "At a glance" as an open notebook: two ruled pages meeting at a ringed
     spine. On narrow screens it folds to one page with rings along the top. */
  .spread {
    --line: 2rem;
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-radius: 10px;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.08),
      0 14px 30px -12px rgb(0 0 0 / 0.3);
  }
  .page {
    --margin: 3rem;
    position: relative;
    padding: var(--line) 28px var(--line) calc(var(--margin) + 14px);
    background-color: var(--paper-raised);
    background-image:
      linear-gradient(to right, transparent var(--margin), rgb(217 83 79 / 0.45) var(--margin) calc(var(--margin) + 1.5px), transparent calc(var(--margin) + 1.5px)),
      repeating-linear-gradient(to bottom, transparent 0 calc(var(--line) - 1px), color-mix(in srgb, var(--rule) 70%, transparent) calc(var(--line) - 1px) var(--line));
  }
  .page--left {
    --margin: calc(28px + 6.5rem + 6px);
    padding-left: 28px;
    border-radius: 10px 0 0 10px;
    /* The page darkens a little as it curves into the spine. */
    box-shadow: inset -24px 0 24px -20px rgb(0 0 0 / 0.25);
  }
  .page--right {
    border-radius: 0 10px 10px 0;
    box-shadow: inset 24px 0 24px -20px rgb(0 0 0 / 0.25);
  }
  /* Binding rings down the spine. */
  .spread::before {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 12px auto 12px 50%;
    width: 22px;
    translate: -50% 0;
    background: radial-gradient(ellipse 9px 5px at 11px 50%, transparent 5px, var(--ink-quiet) 5.5px 7px, transparent 7.5px) 0 0 / 22px var(--line) repeat-y;
  }
  /* A strip of tape holding the top of the left page. */
  .page--left::after {
    content: '';
    position: absolute;
    top: -10px;
    left: 36px;
    width: 84px;
    height: 22px;
    background: color-mix(in srgb, var(--golden) 45%, transparent);
    rotate: -4deg;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }
  .page__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.6rem;
    line-height: var(--line);
    color: var(--accent-text);
  }
  @media (max-width: 760px) {
    .spread {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 12px;
    }
    .page--left,
    .page--right {
      border-radius: 0;
      box-shadow: none;
    }
    .page--left {
      border-radius: 10px 10px 0 0;
    }
    .page--right {
      border-radius: 0 0 10px 10px;
    }
    /* A spiral pad: the rings move to the top edge. */
    .spread::before {
      inset: -9px 12px auto;
      width: auto;
      height: 18px;
      translate: none;
      background: radial-gradient(ellipse 5px 9px at 50% 9px, transparent 5px, var(--ink-quiet) 5.5px 7px, transparent 7.5px) 0 0 / var(--line) 18px repeat-x;
    }
  }
  .notebook {
    margin: 0;
  }
  .notebook > div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    line-height: var(--line);
  }
  .notebook dt {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.2rem;
    color: var(--accent-text);
  }
  .notebook dd {
    margin: 0;
  }
  .notebook dd :global(.chips) {
    padding-block: calc((var(--line) - 1.6rem) / 2);
    row-gap: calc(var(--line) - 1.6rem);
  }
  /* The stats as sticky notes on the right page, each its own muted colour and tilt. */
  .glance {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 4px 0;
    list-style: none;
  }
  .glance li {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 7.5rem;
    padding: 14px 16px;
    border-radius: 3px;
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.08),
      0 6px 10px -6px rgb(0 0 0 / 0.25);
  }
  .glance li:nth-child(4n + 1) {
    background: color-mix(in srgb, var(--golden) 22%, var(--paper-raised));
    rotate: -1.6deg;
  }
  .glance li:nth-child(4n + 2) {
    background: color-mix(in srgb, var(--teal) 18%, var(--paper-raised));
    rotate: 1.2deg;
  }
  .glance li:nth-child(4n + 3) {
    background: color-mix(in srgb, var(--violet) 16%, var(--paper-raised));
    rotate: 0.8deg;
  }
  .glance li:nth-child(4n + 4) {
    background: color-mix(in srgb, var(--butterfly) 18%, var(--paper-raised));
    rotate: -1deg;
  }
  .glance__value {
    font-family: var(--font-display);
    font-size: 2.6rem;
    line-height: 1;
    color: var(--accent-text);
  }
  .glance__label {
    color: var(--ink);
    font-size: 0.9rem;
    line-height: 1.35;
    text-wrap: balance;
  }
  /* A gentle rise as the facts scroll in; anything already in view is shown as is. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .glance li,
      .notebook > div {
        animation: glance-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
    }
  }
  @keyframes glance-rise {
    from {
      opacity: 0.3;
      transform: translateY(12px);
    }
  }
  .contact dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px 32px;
    margin: 12px 0 0;
  }
  dt {
    font-weight: 700;
  }
  dd {
    margin: 0;
    color: var(--ink-quiet);
  }
  .section {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-top: 88px;
  }
  .section h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
  }
  .section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .section__head a {
    font-weight: 700;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 40px 32px;
  }
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .timeline > li {
    display: grid;
    grid-template-columns: minmax(0, 180px) minmax(0, 1fr);
    gap: 8px 32px;
  }
  .timeline__when {
    font-weight: 700;
    color: var(--accent-text);
  }
  .timeline__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .timeline h3 {
    font-size: 1.5rem;
  }
  .timeline__org {
    color: var(--ink-quiet);
  }
  .timeline ul {
    margin: 6px 0 0;
    padding-left: 20px;
    max-width: var(--measure);
  }
  @media (max-width: 640px) {
    .timeline > li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }
  figure {
    margin: 0;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--paper-raised);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  blockquote {
    margin: 0;
  }
  figcaption {
    font-size: 1.5rem;
  }
  .contact p {
    max-width: var(--measure);
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 720px;
    margin-top: 16px;
    padding: clamp(20px, 4vw, 32px);
    border-radius: var(--radius);
    background: var(--paper-raised);
  }
  .contact-form h3 {
    font-size: 1.5rem;
  }
  .contact-form__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }
  .contact-form label:not(.visually-hidden) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-weight: 700;
  }
  .contact-form input,
  .contact-form textarea {
    min-height: 48px;
    padding: 10px 12px;
    border: 1.5px solid var(--rule);
    border-radius: 8px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-weight: 400;
  }
  .contact-form textarea {
    resize: vertical;
  }
  .contact-form [aria-invalid='true'] {
    border-color: #b3261e;
  }
  .contact-form small {
    color: var(--accent-text);
    font-weight: 400;
  }
  .contact-form small:empty,
  .contact-form [role='status']:empty {
    display: none;
  }
  .contact-form__note {
    color: var(--ink-quiet);
    font-size: 0.9375rem;
  }
</style>
