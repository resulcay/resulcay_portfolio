---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Butterfly from '@/components/Butterfly.astro';
import StormScene from '@/components/StormScene.astro';
import type { Locale } from '@/domain/schemas';
import { content } from '@/lib/content';
import { localizePath, t } from '@/i18n/ui';
import { turnstileSiteKey } from '@/lib/auth';
import '@/styles/phone.css';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const [profile, music] = await Promise.all([content.getProfile(), content.listMusic()]);
// The phone in the room holds the contact form.
const siteKey = turnstileSiteKey();
// The room's downloaded models, credited as their licences ask.
const models = [
  { title: 'Crimson Ledger', author: 'mattruszala', license: 'CC BY 4.0', url: 'https://sketchfab.com/3d-models/crimson-ledger-84e9932dd0274af3a2ad91f779b58cf0' },
  { title: 'An Animated Cat', author: 'Evil_Katz', license: 'CC BY 4.0', url: 'https://sketchfab.com/3d-models/an-animated-cat-aec25699660043a29595f9572149d1e8' },
  { title: 'Smart Phone (School Project)', author: 'Ole Gunnar Isager', license: 'CC BY 4.0', url: 'https://sketchfab.com/3d-models/smart-phone-school-project-5134059a9eb844c1b106e4cb7eafd88c' },
  { title: 'Animated Butterfly', author: 'Artistic_side', license: 'CC BY 4.0', url: 'https://sketchfab.com/3d-models/animated-butterfly-d4fbcbaab845402999f30c5aa75851e6' },
  { title: 'Tree S2', author: 'Snowism', license: 'CC BY 4.0', url: 'https://sketchfab.com/3d-models/tree-s2-8f4ee7cc1b5d449caef67c7a095d8556' },
  { title: 'Nightstand - PSX/PS1 Style Low Poly', author: 'Potato Head', license: 'CC BY 4.0', url: 'https://sketchfab.com/3d-models/nightstand-psxps1-style-low-poly-0602c6bde1de457a8c247dd9faadf2da' },
  { title: 'Radio', author: 'oxyuraatheduck', license: 'Royalty Free' },
  { title: 'Bed', author: 'andrey-ryzhko', license: 'Royalty Free' },
];
const sounds = [
  { title: 'Meow', author: 'Yomecerlm3', license: 'Pixabay Content License', url: 'https://pixabay.com/service/license-summary/' },
];
---
<BaseLayout lang={lang} title={t(lang, 'nav.story')} description={t(lang, 'story.description')}>
  <section class="title" aria-labelledby="story-title">
    <StormScene class="title__scene" />
    <div class="wrap title__text">
      <h1 id="story-title"><span class="hand">{t(lang, 'home.kicker')}:</span> {t(lang, 'home.title')}</h1>
      <p class="title__desc">{t(lang, 'story.description')}</p>
      <p class="title__unfit" data-unfit hidden>{t(lang, 'story.unfit')}</p>
      <div class="title__actions">
        <button class="button button--primary start" type="button" data-start data-anyway={t(lang, 'story.tryAnyway')}>
          <Butterfly size={18} class="start__butterfly" />
          <span data-start-label>{t(lang, 'story.start')}</span>
        </button>
        <a class="button" href={localizePath('/', lang)}>{t(lang, 'story.journal')}</a>
        <a class="button" href={profile.cvPath} download data-cv-hit>{t(lang, 'nav.cv')}</a>
      </div>
      <p class="hand title__note">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 15v-3a8 8 0 0 1 16 0v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          <rect x="3" y="14" width="5" height="7" rx="2" fill="currentColor"></rect>
          <rect x="16" y="14" width="5" height="7" rx="2" fill="currentColor"></rect>
        </svg>
        {t(lang, 'story.headphones')}
      </p>
      <p>
        <button type="button" class="credits-link" data-credits-open>{t(lang, 'story.credits')}</button> ·{' '}
        <button type="button" class="credits-link" data-storm-sound data-on={t(lang, 'story.stormOn')} data-off={t(lang, 'story.stormOff')} aria-pressed="true">
          {t(lang, 'story.stormOn')}
        </button>
      </p>
      <p class="title__failed" data-failed role="alert" hidden>{t(lang, 'story.failed')}</p>
    </div>
  </section>

  <dialog class="credits" data-credits aria-labelledby="credits-title">
    <h2 id="credits-title">{t(lang, 'story.credits')}</h2>
    <h3>{t(lang, 'story.music')}</h3>
    {
      music.length > 0 ? (
        <ul>
          {music.map((track) => (
            <li>
              <strong>{track.title}</strong> · {track.artist} · {t(lang, 'story.license')}: {track.license} ·{' '}
              <a href={track.sourceUrl} rel="noopener noreferrer" target="_blank">{t(lang, 'story.source')}</a>
              {track.credit && <p>{track.credit[lang]}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <p>{t(lang, 'story.noTracks')}</p>
      )
    }
    <h3>{t(lang, 'story.models')}</h3>
    <ul>
      {
        models.map((model) => (
          <li>
            <strong>{model.title}</strong> · {model.author} · {t(lang, 'story.license')}: {model.license}
            {model.url && (
              <>
                {' · '}
                <a href={model.url} rel="noopener noreferrer" target="_blank">{t(lang, 'story.source')}</a>
              </>
            )}
          </li>
        ))
      }
    </ul>
    <h3>{t(lang, 'story.sounds')}</h3>
    <ul>
      {
        sounds.map((sound) => (
          <li>
            <strong>{sound.title}</strong> · {sound.author} · {t(lang, 'story.license')}: {sound.license} ·{' '}
            <a href={sound.url} rel="noopener noreferrer" target="_blank">{t(lang, 'story.source')}</a>
          </li>
        ))
      }
    </ul>
    <p class="hand">{t(lang, 'footer.inspired')}</p>
    <button type="button" class="button" data-credits-close>{t(lang, 'story.close')}</button>
  </dialog>

  <div class="stage" data-stage data-url={localizePath('/story/data.json', lang)} data-lang={lang} data-sitekey={siteKey} hidden>
    <div class="stage__canvas" data-canvas></div>
    <div class="stage__vignette" aria-hidden="true"></div>
    <div class="stage__loader" data-loader role="status">
      <Butterfly size={56} class="stage__butterfly" />
      <p>{t(lang, 'story.loading')}</p>
    </div>
    <button class="button stage__back" type="button" data-back>{t(lang, 'story.back')}</button>
  </div>
</BaseLayout>

<script>
  import { readDevice, storyFits } from '@/scripts/story-capability';
  import { unlockAudio } from '@/scripts/audio-unlock';

  const start = document.querySelector<HTMLButtonElement>('[data-start]')!;
  const stage = document.querySelector<HTMLElement>('[data-stage]')!;
  const canvas = document.querySelector<HTMLElement>('[data-canvas]')!;
  const loader = document.querySelector<HTMLElement>('[data-loader]')!;
  const back = document.querySelector<HTMLButtonElement>('[data-back]')!;
  const failed = document.querySelector<HTMLElement>('[data-failed]')!;

  const device = readDevice();
  if (!storyFits(device)) {
    document.querySelector<HTMLElement>('[data-unfit]')!.hidden = false;
    start.querySelector('[data-start-label]')!.textContent = start.dataset['anyway'] ?? '';
  }

  let teardown: (() => void) | undefined;
  // Bumped on every close, so a mount that finishes after Back is undone at once.
  let session = 0;

  function close() {
    session++;
    teardown?.();
    teardown = undefined;
    stage.hidden = true;
    document.documentElement.classList.remove('story-open');
    if (location.hash) history.replaceState(null, '', location.pathname + location.search);
    start.focus();
  }

  function fail(error: unknown) {
    console.error('Story mode failed to start', error);
    close();
    failed.hidden = false;
  }

  start.addEventListener('click', async (event) => {
    if (!stage.hidden) return;
    const id = ++session;
    // Inside a real click, so the browser lets sound start. A deep link's
    // automatic start isn't one; the story then waits for the first tap or key.
    const audio = event.isTrusted ? unlockAudio() : undefined;
    failed.hidden = true;
    loader.hidden = false;
    stage.hidden = false;
    document.documentElement.classList.add('story-open');
    back.focus();
    try {
      const { mountStory } = await import('@/story/main');
      const unmount = await mountStory(canvas, {
        dataUrl: stage.dataset['url']!,
        lang: stage.dataset['lang'] === 'tr' ? 'tr' : 'en',
        siteKey: stage.dataset['sitekey'],
        reducedMotion: device.reducedMotion,
        audio,
        // The room is fully loaded and drawn: fade the veil out over it.
        onReady: () => {
          loader.classList.add('stage__loader--done');
          setTimeout(() => {
            loader.hidden = true;
            loader.classList.remove('stage__loader--done');
          }, 400);
        },
        onError: fail,
      });
      if (id === session) teardown = unmount;
      else unmount();
    } catch (error) {
      void audio?.close();
      if (id === session) fail(error);
    }
  });

  back.addEventListener('click', close);
  addEventListener('keydown', (event) => {
    // With a panel open, Esc closes the panel, not the whole story.
    if (event.key === 'Escape' && !stage.hidden && !stage.querySelector('dialog[open]')) close();
  });

  const credits = document.querySelector<HTMLDialogElement>('[data-credits]')!;
  document.querySelector('[data-credits-open]')!.addEventListener('click', () => credits.showModal());
  document.querySelector('[data-credits-close]')!.addEventListener('click', () => credits.close());
  credits.addEventListener('click', (event) => event.target === credits && credits.close());

  // A deep link such as /story#laptop or #project/macyap opens straight away;
  // #credits (linked from the journal's footer) opens the credits instead.
  if (location.hash === '#credits') credits.showModal();
  else if (location.hash.length > 1 && storyFits(device)) start.click();
</script>

<style>
  /* The title screen: the sunset scene full-bleed, the text over its darker left side. */
  .title {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(calc(100svh - 64px), 900px);
    overflow: hidden;
    color: #f4ebdd;
  }
  .title :global(.title__scene) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .title::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(30 27 36 / 0.6), rgb(30 27 36 / 0.25) 45%, transparent 70%);
  }
  .title__text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-block: clamp(40px, 8vw, 96px);
  }
  .title h1 .hand {
    color: #e8a657;
  }
  .title .button:not(.button--primary) {
    border-color: #f4ebdd;
    background: rgb(30 27 36 / 0.3);
    color: #f4ebdd;
  }
  /* The storm hits Download CV: it trembles as the storm swells, then splits in two (see StormScene). */
  .title .button.is-bracing {
    animation: cv-tremble 0.11s linear infinite;
  }
  .title .button.is-broken,
  .title .button.is-broken:hover {
    position: relative;
    border-color: transparent;
    background: transparent;
    color: transparent;
  }
  @keyframes cv-tremble {
    25% {
      translate: -2px 1px;
    }
    75% {
      translate: 2px -1px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .title .button.is-bracing {
      animation: none;
    }
  }
  .title .title__note {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .title .title__note,
  .title .credits-link {
    color: #ede3d2;
  }
  h1 {
    font-size: clamp(2.75rem, 7vw, 4.5rem);
  }
  h1 .hand {
    display: block;
    font-size: 0.5em;
    color: var(--accent-text);
  }
  .title__desc {
    max-width: 32rem;
    color: #ede3d2;
    font-size: 1.1875rem;
  }
  .title__unfit,
  .title__failed {
    max-width: var(--measure);
    padding: 12px 16px;
    border-left: 4px solid var(--golden);
    background: var(--paper-raised);
    color: var(--ink);
  }
  .title__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .start :global(.start__butterfly) {
    transform-origin: center;
  }
  .start:hover :global(.start__butterfly),
  .start:focus-visible :global(.start__butterfly) {
    animation: flutter 0.35s ease-in-out infinite alternate;
  }
  @media (prefers-reduced-motion: reduce) {
    .start:hover :global(.start__butterfly),
    .start:focus-visible :global(.start__butterfly) {
      animation: none;
    }
  }
  .credits-link {
    padding: 0;
    border: 0;
    background: none;
    color: var(--link);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    cursor: var(--cursor-link, pointer);
    min-height: 44px;
  }
  .credits {
    width: min(560px, calc(100% - 24px));
    padding: clamp(18px, 4vw, 32px);
    border: 0;
    border-radius: 6px;
    background: var(--paper-raised);
    color: var(--ink);
  }
  .credits::backdrop {
    background: rgb(30 27 36 / 0.45);
  }
  .credits h2 {
    font-size: 2rem;
  }
  .credits h3 {
    margin-top: 16px;
    font-size: 1.25rem;
  }
  .credits ul {
    padding-left: 20px;
  }
  .credits .hand {
    margin-block: 16px;
    font-size: 1.375rem;
  }
  .title__note {
    font-size: 1.375rem;
    color: var(--ink-quiet);
  }

  .stage:not([hidden]) {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #2a2140;
  }
  .stage__canvas {
    position: absolute;
    inset: 0;
  }
  .stage__vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at 50% 45%, transparent 55%, rgb(30 27 36 / 0.55));
  }
  .stage__loader:not([hidden]) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: #f4ebdd;
    font-family: var(--font-hand);
    font-size: 1.5rem;
    /* Opaque, the room's own colour: nothing shows until it's all loaded. */
    background: #2a2140;
  }
  .stage__loader--done {
    animation: stage-fade-out 0.4s forwards;
  }
  @keyframes stage-fade-out {
    to {
      opacity: 0;
    }
  }
  .stage__loader :global(.stage__butterfly) {
    animation:
      flutter 0.5s ease-in-out infinite alternate,
      stage-pulse 1.6s ease-in-out infinite;
  }
  @keyframes stage-pulse {
    50% {
      opacity: 0.55;
    }
  }
  @keyframes flutter {
    to {
      transform: scaleX(0.4) translateY(-6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage__loader :global(.stage__butterfly) {
      animation: none;
    }
  }
  .stage__back {
    position: absolute;
    top: 16px;
    left: 16px;
    background: #f4ebdd;
    color: #1e1b24;
    border-color: #f4ebdd;
  }
  .stage__back:hover {
    background: #e8a657;
    color: #1e1b24;
  }
  :global(html.story-open) {
    overflow: hidden;
  }
</style>

<!-- Story mode's React UI renders outside this component's scope, so its styles are global and prefixed. -->
<style is:global>
  /* The two halves of Download CV after the storm breaks it, drawn over the still-working link. */
  .cv-half {
    position: absolute;
    inset: -1.5px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid #f4ebdd;
    border-radius: inherit;
    background: rgb(30 27 36 / 0.55);
    color: #f4ebdd;
    pointer-events: none;
    /* Longhands: a shorthand without a name gets minified to "animation: none" in production. */
    animation-duration: 0.7s;
    animation-timing-function: cubic-bezier(0.2, 0.8, 0.3, 1.3);
    animation-fill-mode: forwards;
  }
  .cv-half--left {
    clip-path: polygon(0 0, 56% 0, 48% 30%, 60% 56%, 50% 100%, 0 100%);
    transform-origin: 0 100%;
    animation-name: cv-half-left;
  }
  .cv-half--right {
    clip-path: polygon(56% 0, 86% 0, 82% 24%, 100% 32%, 100% 100%, 50% 100%, 60% 56%, 48% 30%);
    transform-origin: 100% 100%;
    animation-name: cv-half-right;
  }
  @keyframes cv-half-left {
    to {
      translate: -8px 6px;
      rotate: -8deg;
    }
  }
  @keyframes cv-half-right {
    to {
      translate: 14px 18px;
      rotate: 15deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cv-half {
      animation-duration: 1ms;
    }
  }
  /* Fragments knocked off Download CV by the storm. */
  .cv-shard {
    position: fixed;
    z-index: 5;
    background: #f4ebdd;
    pointer-events: none;
    animation: cv-shard 0.9s cubic-bezier(0.2, 0.7, 0.4, 1) forwards;
  }
  @keyframes cv-shard {
    to {
      translate: var(--dx) var(--dy);
      rotate: var(--r);
      opacity: 0;
    }
  }
  .story-objects {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .story-scene {
    position: absolute;
    inset: 0;
  }
  .story-thought {
    position: absolute;
    left: 50%;
    top: 16px;
    translate: -50% 0;
    width: max-content;
    max-width: calc(100% - 280px);
    padding: 8px 18px;
    border-radius: 999px;
    background: rgb(244 235 221 / 0.92);
    color: #1e1b24;
    font-family: var(--font-hand);
    font-size: 1.5rem;
    line-height: 1.3;
    text-align: center;
    pointer-events: none;
  }
  .story-thought:empty {
    display: none;
  }
  /* On phones the Back and mute buttons take the top corners, so the thought drops below them. */
  @media (max-width: 640px) {
    .story-thought {
      top: 72px;
      max-width: calc(100% - 32px);
    }
  }
  .story-hint {
    position: absolute;
    left: 50%;
    bottom: 20px;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 10px;
    width: max-content;
    max-width: calc(100% - 136px);
    margin: 0;
    padding: 8px 18px 8px 12px;
    border-radius: 999px;
    background: rgb(244 235 221 / 0.92);
    color: #1e1b24;
    font-family: var(--font-hand);
    font-size: 1.3rem;
    line-height: 1.2;
    pointer-events: none;
    animation: hint-in 600ms ease-out both;
  }
  .story-hint__hand {
    flex: none;
    animation: hint-tap 1.6s ease-in-out infinite;
  }
  .story-hint__ripple {
    transform-origin: 9px 5px;
    animation: hint-ripple 1.6s ease-out infinite;
  }
  @keyframes hint-in {
    from {
      opacity: 0;
      translate: -50% 12px;
    }
  }
  @keyframes hint-tap {
    0%,
    60%,
    100% {
      transform: translateY(0);
    }
    30% {
      transform: translateY(3px) scale(0.92);
    }
  }
  @keyframes hint-ripple {
    0%,
    25% {
      opacity: 0;
      transform: scale(0.4);
    }
    35% {
      opacity: 1;
    }
    80%,
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .story-hint,
    .story-hint__hand,
    .story-hint__ripple {
      animation: none;
    }
  }
  .story-hud {
    position: absolute;
    left: 50%;
    bottom: 76px;
    translate: -50% 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px;
    width: max-content;
    max-width: calc(100% - 32px);
  }
  .story-chip {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 6px 16px;
    border: 0;
    border-radius: 999px;
    background: #e8a657;
    color: #1e1b24;
    font: inherit;
    font-weight: 700;
    text-decoration: none;
    cursor: var(--cursor-link, pointer);
  }
  .story-chip:hover {
    background: #f4ebdd;
    color: #1e1b24;
  }
  .story-hud__change {
    min-height: 40px;
    padding: 6px 10px;
    border: 0;
    background: none;
    color: #f4ebdd;
    font: inherit;
    text-decoration: underline;
    cursor: var(--cursor-link, pointer);
  }
  .story-mute {
    position: absolute;
    top: 16px;
    right: 16px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: #f4ebdd;
    color: #1e1b24;
    cursor: var(--cursor-link, pointer);
  }
  .story-fullscreen {
    position: absolute;
    right: 16px;
    bottom: 16px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: #f4ebdd;
    color: #1e1b24;
    cursor: var(--cursor-link, pointer);
  }
  .story-mute[aria-pressed='true'] {
    background: #4a4350;
    color: #f4ebdd;
  }
  .story-rewind {
    position: absolute;
    top: 20px;
    left: 50%;
    translate: -50% 0;
    color: #f4ebdd;
    filter: drop-shadow(0 2px 6px rgb(30 27 36 / 0.6));
  }
  .story-debug {
    position: absolute;
    top: 16px;
    left: 50%;
    z-index: 1;
    translate: -50% 0;
    display: flex;
    gap: 8px;
  }
  .story-debug [aria-pressed='true'] {
    background: #f4ebdd;
  }
  .story-choice {
    width: min(520px, calc(100% - 24px));
  }

  /* ── Story mode's pages: one dialog, a look per object (src/story/panels.tsx) ── */
  .story-panel {
    width: min(760px, calc(100% - 24px));
    max-height: min(88vh, 940px);
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: var(--paper-raised);
    color: var(--ink);
    box-shadow: 0 24px 60px rgb(30 27 36 / 0.45);
  }
  .story-panel[open] {
    animation: story-page-in 0.35s cubic-bezier(0.2, 0.8, 0.3, 1.15);
  }
  @keyframes story-page-in {
    from {
      opacity: 0;
      translate: 0 18px;
      scale: 0.97;
    }
  }
  .story-panel::backdrop {
    background: rgb(30 27 36 / 0.5);
    backdrop-filter: blur(2px);
  }
  .story-panel__page {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(18px, 4vw, 36px);
  }
  .story-panel__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }
  .story-panel h2 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
  }
  .story-panel h3 {
    margin-top: 10px;
    font-size: 1.375rem;
  }
  .story-panel ul,
  .story-panel ol {
    margin: 0;
    padding-left: 20px;
  }
  .story-panel img {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .story-panel__close {
    flex: none;
    min-height: 44px;
    padding: 8px 16px;
  }
  .story-choice {
    width: min(520px, calc(100% - 24px));
  }
  .story-meta {
    margin: 0;
    color: var(--ink-quiet);
    font-size: 0.9375rem;
  }
  .story-hook {
    margin: 0;
    font-size: 1.5rem;
    color: var(--accent-text);
  }
  .story-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .story-badge,
  .story-panel .story-chips li {
    display: inline-block;
    padding: 2px 10px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.8125rem;
  }
  .story-badge {
    margin-left: 8px;
    border-color: var(--golden);
  }
  .story-panel .story-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    list-style: none;
  }
  .story-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 0;
    font-weight: 700;
  }

  /* Devices (the phone and the laptop): no paper page, the device is the page. */
  .story-panel--phone,
  .story-panel--laptop {
    width: min(980px, calc(100% - 24px));
    background: none;
    box-shadow: none;
    color: #f4ebdd;
  }
  /* The light heading is for the room behind; the screens keep the page's ink. */
  .story-panel--phone .phone__screen {
    color: var(--ink);
  }
  .story-panel--phone .story-panel__page,
  .story-panel--laptop .story-panel__page {
    padding: 8px 4px 16px;
  }
  .story-panel--phone h2,
  .story-panel--laptop h2 {
    color: #f4ebdd;
    text-shadow: 0 2px 10px rgb(0 0 0 / 0.5);
  }
  .story-panel--phone .story-panel__close,
  .story-panel--laptop .story-panel__close {
    border-color: #f4ebdd;
    background: rgb(30 27 36 / 0.55);
    color: #f4ebdd;
  }
  .story-panel--phone .phone {
    margin-top: 0;
  }
  /* The phone's notification: the story's little joke drops in under the status bar. */
  .story-notification {
    grid-column: 1 / -1;
    margin: 8px 12px 0;
    padding: 10px 16px;
    border-radius: 16px;
    background: #1e1b24;
    color: #f4ebdd;
    font-family: var(--font-hand);
    font-size: 1.25rem;
    text-align: center;
    box-shadow: 0 8px 18px -8px rgb(0 0 0 / 0.5);
    animation: story-notification 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.2);
  }
  @keyframes story-notification {
    from {
      opacity: 0;
      translate: 0 -24px;
    }
  }

  /* The laptop: a dark bezel, an app window with its title bar, and the keyboard deck below. */
  .story-laptop {
    position: relative;
    padding: 18px 18px 22px;
    border: 2px solid #3a3542;
    border-radius: 18px 18px 6px 6px;
    background: #121015;
  }
  .story-laptop::after {
    content: '';
    position: absolute;
    left: -6%;
    right: -6%;
    bottom: -16px;
    height: 16px;
    border-radius: 0 0 18px 18px;
    background: linear-gradient(#3a3542, #24212b);
    clip-path: polygon(0 0, 100% 0, 97% 100%, 3% 100%);
  }
  .story-laptop__screen {
    max-height: min(64vh, 640px);
    overflow: auto;
    border-radius: 6px;
    background: var(--paper-raised);
    color: var(--ink);
  }
  .story-laptop__bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    padding: 9px 14px;
    background: color-mix(in srgb, var(--violet) 80%, black);
    color: #f4ebdd;
    font-size: 0.8125rem;
  }
  .story-laptop__bar span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #d9534f;
  }
  .story-laptop__bar span:nth-child(2) {
    background: #e8a657;
  }
  .story-laptop__bar span:nth-child(3) {
    background: #2f6f73;
  }
  .story-laptop__bar b {
    margin-left: 8px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  /* The experience as the home page's path: a dashed line with a butterfly at each role. */
  .story-panel .story-timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 20px 22px 24px 54px;
    list-style: none;
  }
  .story-timeline::before {
    content: '';
    position: absolute;
    top: 30px;
    bottom: 30px;
    left: 30px;
    border-left: 2px dashed var(--rule);
  }
  .story-timeline > li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .story-timeline > li::before {
    content: '';
    position: absolute;
    top: 0;
    left: -38px;
    width: 26px;
    height: 26px;
    background: url('/cursors/butterfly.svg') center / contain no-repeat;
  }
  .story-timeline__when {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--accent-text);
  }
  .story-timeline h3 {
    margin: 0;
  }
  .story-timeline ul {
    margin-top: 6px;
  }

  /* The photo wall: polaroids with a strip of tape, tilted, straightening when picked up. */
  .story-panel--wall,
  .story-panel--case {
    background:
      radial-gradient(rgb(90 60 30 / 0.3) 1px, transparent 1.6px) 0 0 / 9px 9px,
      #b98a5a;
    border: 10px solid #6b4a2f;
    border-radius: 12px;
  }
  .story-panel--wall h2,
  .story-panel--case h2 {
    color: #1e1b24;
  }
  .story-panel--wall .story-panel__close,
  .story-panel--case .story-panel__close {
    border-color: #1e1b24;
    background: rgb(251 246 238 / 0.85);
    color: #1e1b24;
  }
  .story-wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 26px 20px;
    padding: 10px 4px 4px !important;
    list-style: none;
  }
  .story-wall button {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
    height: 100%;
    padding: 10px 10px 16px;
    border: 0;
    border-radius: 3px;
    background: #fbf6ee;
    color: #1e1b24;
    font: inherit;
    text-align: left;
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.18), 0 10px 20px -10px rgb(0 0 0 / 0.45);
    rotate: -2deg;
    transition:
      rotate 0.25s,
      translate 0.25s,
      box-shadow 0.25s;
    cursor: var(--cursor-link, pointer);
  }
  .story-wall li:nth-child(3n + 2) button {
    rotate: 1.6deg;
  }
  .story-wall li:nth-child(3n + 3) button {
    rotate: -0.8deg;
  }
  /* A strip of washi tape holding each one up. */
  .story-wall button::before {
    content: '';
    position: absolute;
    top: -9px;
    left: 50%;
    width: 64px;
    height: 18px;
    translate: -50% 0;
    rotate: -3deg;
    background:
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.3) 0 4px, transparent 4px 9px),
      rgb(232 166 87 / 0.8);
  }
  .story-wall button:hover,
  .story-wall button:focus-visible {
    rotate: 0deg;
    translate: 0 -4px;
    box-shadow: 0 4px 8px rgb(0 0 0 / 0.2), 0 18px 30px -12px rgb(0 0 0 / 0.5);
  }
  .story-wall strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }
  .story-wall span:not(.story-photo) {
    color: #4a4350;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .story-photo {
    display: block;
    aspect-ratio: 8 / 5;
    overflow: hidden;
    background: #1e1b24;
  }
  .story-photo svg,
  .story-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0 !important;
  }
  /* One project: a big polaroid pinned above a journal page. */
  .story-case {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px clamp(16px, 3vw, 28px) 24px;
    border-radius: 4px;
    background: var(--paper-raised);
    box-shadow: 0 10px 24px -12px rgb(0 0 0 / 0.5);
  }
  .story-case p {
    margin: 0;
  }
  .story-case__polaroid {
    position: relative;
    width: min(100%, 420px);
    margin: -6px auto 6px;
    padding: 12px 12px 14px;
    background: #fbf6ee;
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.2), 0 14px 28px -12px rgb(0 0 0 / 0.5);
    rotate: -1.5deg;
  }
  .story-case__polaroid::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 50%;
    width: 18px;
    height: 18px;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #ff9a8a, #d9534f 55%, #8c2a26);
    box-shadow: 0 3px 3px rgb(0 0 0 / 0.3);
  }
  .story-case__polaroid figcaption {
    margin-top: 10px;
    color: #3b3060;
    font-size: 1.3rem;
    line-height: 1.25;
    text-align: center;
  }
  .story-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 10px 24px;
    margin: 0;
    padding: 12px 0;
    border-block: 1.5px dashed var(--rule);
  }
  .story-facts dt {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--accent-text);
  }
  .story-facts dd {
    margin: 0;
  }
  .story-highlights {
    list-style: none;
    padding-left: 0 !important;
  }
  .story-highlights li {
    position: relative;
    padding-left: 26px;
  }
  .story-highlights li::before {
    content: '✦';
    position: absolute;
    left: 4px;
    color: var(--golden);
  }

  /* The journal: a notebook page with ring holes, ruled lines and a red margin. */
  .story-panel--journal .story-panel__page {
    position: relative;
    padding-left: clamp(56px, 9vw, 84px);
    background:
      linear-gradient(90deg, transparent calc(clamp(56px, 9vw, 84px) - 14px), rgb(217 83 79 / 0.55) calc(clamp(56px, 9vw, 84px) - 14px) calc(clamp(56px, 9vw, 84px) - 12px), transparent 0),
      repeating-linear-gradient(to bottom, transparent 0 31px, color-mix(in srgb, var(--link) 22%, transparent) 31px 32px),
      var(--paper-raised);
  }
  .story-panel--journal .story-panel__page::before {
    content: '';
    position: absolute;
    top: 24px;
    bottom: 24px;
    left: 14px;
    width: 18px;
    background: radial-gradient(circle, var(--paper) 5px, color-mix(in srgb, var(--ink) 25%, transparent) 6px, transparent 7px) 0 0 / 18px 54px repeat-y;
  }
  .story-panel--journal h3 {
    font-weight: 600;
    color: var(--accent-text);
  }
  .story-journal__lead {
    margin: 0;
    font-size: 1.0625rem;
  }
  .story-skills {
    display: grid;
    gap: 12px;
    margin: 0;
  }
  .story-skills dt {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }
  .story-skills dd {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 4px 0 0;
  }
  /* Each skill on a scrap of washi tape. */
  .story-skills dd span {
    padding: 1px 10px;
    background:
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.25) 0 4px, transparent 4px 9px),
      color-mix(in srgb, var(--golden) 40%, transparent);
    font-size: 0.875rem;
    font-weight: 700;
  }
  .story-skills dd span:nth-child(3n + 2) {
    background-color: color-mix(in srgb, var(--butterfly) 32%, transparent);
  }
  .story-skills dd span:nth-child(3n + 3) {
    background-color: color-mix(in srgb, var(--violet) 26%, transparent);
  }
  .story-schools {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .story-notes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 18px;
    padding-top: 8px;
  }
  /* Testimonials as notes taped into the journal. */
  .story-quote {
    position: relative;
    margin: 0;
    padding: 20px 16px 14px;
    background: color-mix(in srgb, var(--golden) 22%, var(--paper-raised));
    box-shadow: 0 8px 16px -10px rgb(0 0 0 / 0.4);
    rotate: -1deg;
  }
  .story-quote:nth-child(2) {
    background: color-mix(in srgb, var(--teal) 18%, var(--paper-raised));
    rotate: 1.2deg;
  }
  .story-quote:nth-child(3) {
    background: color-mix(in srgb, var(--violet) 16%, var(--paper-raised));
    rotate: -0.5deg;
  }
  .story-quote::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 50%;
    width: 56px;
    height: 16px;
    translate: -50% 0;
    rotate: 2deg;
    background: rgb(244 235 221 / 0.75);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.15);
  }
  .story-quote p {
    margin: 0;
    font-size: 0.9375rem;
  }
  .story-quote footer {
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: 1.2rem;
    text-align: right;
  }
  .story-quote footer::before {
    content: '— ';
  }

  /* The cork board: the home page's board in its wooden frame, with pinned index cards. */
  .story-panel--cork {
    border: 12px solid #6b4a2f;
    border-radius: 14px;
    background:
      radial-gradient(rgb(90 60 30 / 0.35) 1px, transparent 1.6px) 0 0 / 9px 9px,
      #b98a5a;
  }
  .story-panel--cork h2 {
    color: #1e1b24;
  }
  .story-panel--cork .story-panel__close {
    border-color: #1e1b24;
    background: rgb(251 246 238 / 0.85);
    color: #1e1b24;
  }
  .story-pins {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 26px 20px;
    padding: 10px 4px 6px !important;
    list-style: none;
  }
  .story-pins li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 16px 16px;
    background: repeating-linear-gradient(to bottom, #fbf6ee 0 23px, rgb(79 163 217 / 0.25) 23px 24px) 0 34px / 100% 100% no-repeat, #fbf6ee;
    color: #1e1b24;
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.18), 0 10px 20px -10px rgb(0 0 0 / 0.45);
    rotate: -1.4deg;
  }
  .story-pins li:nth-child(even) {
    rotate: 1.2deg;
  }
  .story-pins li::before {
    content: '';
    position: absolute;
    top: -7px;
    left: 50%;
    width: 16px;
    height: 16px;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #ff9a8a, #d9534f 55%, #8c2a26);
    box-shadow: 0 3px 3px rgb(0 0 0 / 0.3);
  }
  .story-pins li:nth-child(3n + 2)::before {
    background: radial-gradient(circle at 35% 35%, #9fd6f2, #4fa3d9 55%, #2a5f86);
  }
  .story-pins li:nth-child(3n + 3)::before {
    background: radial-gradient(circle at 35% 35%, #ffd9a0, #e8a657 55%, #9a6a2f);
  }
  .story-pins strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .story-pins span {
    color: #4a4350;
    font-size: 0.875rem;
  }

  /* The record player: a record that turns while music plays, beside what's on. */
  .story-panel--record .story-panel__page {
    background:
      radial-gradient(circle at 85% -10%, color-mix(in srgb, var(--golden) 22%, transparent), transparent 55%),
      var(--paper-raised);
  }
  .story-deck {
    display: flex;
    align-items: center;
    gap: clamp(16px, 4vw, 32px);
  }
  .story-deck__now {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .story-vinyl {
    position: relative;
    flex: none;
    width: clamp(110px, 22vw, 150px);
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      repeating-radial-gradient(circle, #1e1b24 0 2px, #2a2532 2px 4px),
      #1e1b24;
    box-shadow: 0 10px 24px -10px rgb(0 0 0 / 0.6), inset 0 0 0 3px #121015;
  }
  .story-vinyl::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 30deg, transparent 0 20%, rgb(255 255 255 / 0.12) 25%, transparent 32% 70%, rgb(255 255 255 / 0.08) 75%, transparent 82%);
  }
  .story-vinyl span {
    position: absolute;
    inset: 34%;
    border-radius: 50%;
    background: radial-gradient(circle, #1e1b24 0 7%, #e8a657 8% 100%);
    box-shadow: inset 0 0 0 4px #5b4b8a;
  }
  .story-vinyl.is-playing {
    animation: story-spin 1.8s linear infinite;
  }
  @keyframes story-spin {
    to {
      rotate: 1turn;
    }
  }
  .story-soon {
    margin: 0;
    font-size: 1.6rem;
  }
  .story-tracks {
    display: flex;
    flex-direction: column;
    padding: 0 !important;
    list-style: none;
    counter-reset: track;
  }
  .story-tracks li {
    border-bottom: 1px dashed var(--rule);
    counter-increment: track;
  }
  .story-tracks button {
    display: flex;
    gap: 12px;
    width: 100%;
    min-height: 44px;
    align-items: center;
    padding: 6px 4px;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: var(--cursor-link, pointer);
  }
  .story-tracks button::before {
    content: counter(track, decimal-leading-zero);
    font-family: var(--font-display);
    color: var(--ink-quiet);
  }
  .story-tracks button[aria-current='true'] {
    font-weight: 700;
    color: var(--accent-text);
  }
  .story-tracks button[aria-current='true']::before {
    content: '♪';
    color: var(--golden);
  }
  .story-sliders {
    display: grid;
    gap: 6px;
  }
  .story-sliders label {
    display: grid;
    grid-template-columns: 9rem 1fr;
    align-items: center;
    gap: 12px;
    font-weight: 700;
  }
  .story-sliders input {
    accent-color: #e8a657;
    min-height: 44px;
  }
  .story-credits {
    font-size: 0.9375rem;
  }

  /* The window: one pane per time of day, each showing its sky. */
  .story-skies {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 12px;
    border: 0;
    border-radius: 8px;
    background: #6b4a2f;
    box-shadow: inset 0 0 0 4px #5a3d26;
  }
  .story-sky {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 120px;
    padding: 12px;
    border-radius: 4px;
    color: #f4ebdd;
    font-family: var(--font-display);
    font-size: 1.35rem;
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.5);
    cursor: var(--cursor-link, pointer);
    box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.15);
    transition: box-shadow 0.2s;
  }
  .story-sky input {
    position: absolute;
    opacity: 0;
  }
  .story-sky:has(input:checked) {
    box-shadow: inset 0 0 0 4px #e8a657, 0 0 18px rgb(232 166 87 / 0.5);
  }
  .story-sky:has(input:focus-visible) {
    outline: 3px solid #f4ebdd;
    outline-offset: 2px;
  }
  .story-sky--dawn {
    background: linear-gradient(#5b4b8a, #d98a62 70%, #f6c47e);
  }
  .story-sky--day {
    background: linear-gradient(#4fa3d9, #a9dcf7);
    color: #1e1b24;
    text-shadow: none;
  }
  .story-sky--golden {
    background: linear-gradient(#9a6a86, #e8a657 75%);
  }
  .story-sky--night {
    background:
      radial-gradient(circle at 70% 30%, #f4ebdd 0 1.5px, transparent 2px),
      radial-gradient(circle at 25% 55%, #f4ebdd 0 1px, transparent 1.5px),
      radial-gradient(circle at 80% 70%, #f4ebdd 0 1px, transparent 1.5px),
      linear-gradient(#1e1b24, #3b3060);
  }
  .story-sky--auto {
    grid-column: 1 / -1;
