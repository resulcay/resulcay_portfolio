---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Butterfly from '@/components/Butterfly.astro';
import StormScene from '@/components/StormScene.astro';
import type { Locale } from '@/domain/schemas';
import { content } from '@/lib/content';
import { localizePath, t } from '@/i18n/ui';
import { turnstileSiteKey } from '@/lib/auth';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const [profile, music] = await Promise.all([content.getProfile(), content.listMusic()]);
// The phone in the room holds the contact form.
const siteKey = turnstileSiteKey();
// The room's downloaded models, credited as their licences ask.
const models = [
  { title: 'Crimson Ledger', author: 'mattruszala', license: 'CC BY 4.0', url: 'https://sketchfab.com/3d-models/crimson-ledger-84e9932dd0274af3a2ad91f779b58cf0' },
  { title: 'An Animated Cat', author: 'Evil_Katz', license: 'CC BY 4.0', url: 'https://sketchfab.com/3d-models/an-animated-cat-aec25699660043a29595f9572149d1e8' },
  { title: 'Smart Phone (School Project)', author: 'Ole Gunnar Isager', license: 'CC BY 4.0', url: 'https://sketchfab.com/3d-models/smart-phone-school-project-5134059a9eb844c1b106e4cb7eafd88c' },
  { title: 'Animated Butterfly', author: 'Artistic_side', license: 'CC BY 4.0', url: 'https://sketchfab.com/3d-models/animated-butterfly-d4fbcbaab845402999f30c5aa75851e6' },
  { title: 'Tree S2', author: 'Snowism', license: 'CC BY 4.0', url: 'https://sketchfab.com/3d-models/tree-s2-8f4ee7cc1b5d449caef67c7a095d8556' },
  { title: 'Nightstand - PSX/PS1 Style Low Poly', author: 'Potato Head', license: 'CC BY 4.0', url: 'https://sketchfab.com/3d-models/nightstand-psxps1-style-low-poly-0602c6bde1de457a8c247dd9faadf2da' },
  { title: 'Radio', author: 'oxyuraatheduck', license: 'Royalty Free' },
  { title: 'Bed', author: 'andrey-ryzhko', license: 'Royalty Free' },
];
const sounds = [
  { title: 'Meow', author: 'Yomecerlm3', license: 'Pixabay Content License', url: 'https://pixabay.com/service/license-summary/' },
];
---
<BaseLayout lang={lang} title={t(lang, 'nav.story')} description={t(lang, 'story.description')}>
  <section class="title" aria-labelledby="story-title">
    <StormScene class="title__scene" />
    <div class="wrap title__text">
      <h1 id="story-title"><span class="hand">{t(lang, 'home.kicker')}:</span> {t(lang, 'home.title')}</h1>
      <p class="title__desc">{t(lang, 'story.description')}</p>
      <p class="title__unfit" data-unfit hidden>{t(lang, 'story.unfit')}</p>
      <div class="title__actions">
        <button class="button button--primary start" type="button" data-start data-anyway={t(lang, 'story.tryAnyway')}>
          <Butterfly size={18} class="start__butterfly" />
          <span data-start-label>{t(lang, 'story.start')}</span>
        </button>
        <a class="button" href={localizePath('/', lang)}>{t(lang, 'story.journal')}</a>
        <a class="button" href={profile.cvPath} download>{t(lang, 'nav.cv')}</a>
      </div>
      <p class="hand title__note">{t(lang, 'story.headphones')}</p>
      <p><button type="button" class="credits-link" data-credits-open>{t(lang, 'story.credits')}</button></p>
      <p class="title__failed" data-failed role="alert" hidden>{t(lang, 'story.failed')}</p>
    </div>
  </section>

  <dialog class="credits" data-credits aria-labelledby="credits-title">
    <h2 id="credits-title">{t(lang, 'story.credits')}</h2>
    <h3>{t(lang, 'story.music')}</h3>
    {
      music.length > 0 ? (
        <ul>
          {music.map((track) => (
            <li>
              <strong>{track.title}</strong> · {track.artist} · {t(lang, 'story.license')}: {track.license} ·{' '}
              <a href={track.sourceUrl} rel="noopener noreferrer" target="_blank">{t(lang, 'story.source')}</a>
              {track.credit && <p>{track.credit[lang]}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <p>{t(lang, 'story.noTracks')}</p>
      )
    }
    <h3>{t(lang, 'story.models')}</h3>
    <ul>
      {
        models.map((model) => (
          <li>
            <strong>{model.title}</strong> · {model.author} · {t(lang, 'story.license')}: {model.license}
            {model.url && (
              <>
                {' · '}
                <a href={model.url} rel="noopener noreferrer" target="_blank">{t(lang, 'story.source')}</a>
              </>
            )}
          </li>
        ))
      }
    </ul>
    <h3>{t(lang, 'story.sounds')}</h3>
    <ul>
      {
        sounds.map((sound) => (
          <li>
            <strong>{sound.title}</strong> · {sound.author} · {t(lang, 'story.license')}: {sound.license} ·{' '}
            <a href={sound.url} rel="noopener noreferrer" target="_blank">{t(lang, 'story.source')}</a>
          </li>
        ))
      }
    </ul>
    <p class="hand">{t(lang, 'footer.inspired')}</p>
    <button type="button" class="button" data-credits-close>{t(lang, 'story.close')}</button>
  </dialog>

  <div class="stage" data-stage data-url={localizePath('/story/data.json', lang)} data-lang={lang} data-sitekey={siteKey} hidden>
    <div class="stage__canvas" data-canvas></div>
    <div class="stage__vignette" aria-hidden="true"></div>
    <div class="stage__loader" data-loader role="status">
      <Butterfly size={56} class="stage__butterfly" />
      <p>{t(lang, 'story.loading')}</p>
    </div>
    <button class="button stage__back" type="button" data-back>{t(lang, 'story.back')}</button>
  </div>
</BaseLayout>

<script>
  import { readDevice, storyFits } from '@/scripts/story-capability';
  import { unlockAudio } from '@/scripts/audio-unlock';

  const start = document.querySelector<HTMLButtonElement>('[data-start]')!;
  const stage = document.querySelector<HTMLElement>('[data-stage]')!;
  const canvas = document.querySelector<HTMLElement>('[data-canvas]')!;
  const loader = document.querySelector<HTMLElement>('[data-loader]')!;
  const back = document.querySelector<HTMLButtonElement>('[data-back]')!;
  const failed = document.querySelector<HTMLElement>('[data-failed]')!;

  const device = readDevice();
  if (!storyFits(device)) {
    document.querySelector<HTMLElement>('[data-unfit]')!.hidden = false;
    start.querySelector('[data-start-label]')!.textContent = start.dataset['anyway'] ?? '';
  }

  let teardown: (() => void) | undefined;
  // Bumped on every close, so a mount that finishes after Back is undone at once.
  let session = 0;

  function close() {
    session++;
    teardown?.();
    teardown = undefined;
    stage.hidden = true;
    document.documentElement.classList.remove('story-open');
    if (location.hash) history.replaceState(null, '', location.pathname + location.search);
    start.focus();
  }

  function fail(error: unknown) {
    console.error('Story mode failed to start', error);
    close();
    failed.hidden = false;
  }

  start.addEventListener('click', async (event) => {
    if (!stage.hidden) return;
    const id = ++session;
    // Inside a real click, so the browser lets sound start. A deep link's
    // automatic start isn't one; the story then waits for the first tap or key.
    const audio = event.isTrusted ? unlockAudio() : undefined;
    failed.hidden = true;
    loader.hidden = false;
    stage.hidden = false;
    document.documentElement.classList.add('story-open');
    back.focus();
    try {
      const { mountStory } = await import('@/story/main');
      const unmount = await mountStory(canvas, {
        dataUrl: stage.dataset['url']!,
        lang: stage.dataset['lang'] === 'tr' ? 'tr' : 'en',
        siteKey: stage.dataset['sitekey'],
        reducedMotion: device.reducedMotion,
        audio,
        // The room is fully loaded and drawn: fade the veil out over it.
        onReady: () => {
          loader.classList.add('stage__loader--done');
          setTimeout(() => {
            loader.hidden = true;
            loader.classList.remove('stage__loader--done');
          }, 400);
        },
        onError: fail,
      });
      if (id === session) teardown = unmount;
      else unmount();
    } catch (error) {
      void audio?.close();
      if (id === session) fail(error);
    }
  });

  back.addEventListener('click', close);
  addEventListener('keydown', (event) => {
    // With a panel open, Esc closes the panel, not the whole story.
    if (event.key === 'Escape' && !stage.hidden && !stage.querySelector('dialog[open]')) close();
  });

  const credits = document.querySelector<HTMLDialogElement>('[data-credits]')!;
  document.querySelector('[data-credits-open]')!.addEventListener('click', () => credits.showModal());
  document.querySelector('[data-credits-close]')!.addEventListener('click', () => credits.close());
  credits.addEventListener('click', (event) => event.target === credits && credits.close());

  // A deep link such as /story#laptop or #project/macyap opens straight away;
  // #credits (linked from the journal's footer) opens the credits instead.
  if (location.hash === '#credits') credits.showModal();
  else if (location.hash.length > 1 && storyFits(device)) start.click();
</script>

<style>
  /* The title screen: the sunset scene full-bleed, the text over its darker left side. */
  .title {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(calc(100svh - 64px), 900px);
    overflow: hidden;
    color: #f4ebdd;
  }
  .title :global(.title__scene) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .title::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(30 27 36 / 0.6), rgb(30 27 36 / 0.25) 45%, transparent 70%);
  }
  .title__text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-block: clamp(40px, 8vw, 96px);
  }
  .title h1 .hand {
    color: #e8a657;
  }
  .title .button:not(.button--primary) {
    border-color: #f4ebdd;
    background: rgb(30 27 36 / 0.3);
    color: #f4ebdd;
  }
  .title .title__note,
  .title .credits-link {
    color: #ede3d2;
  }
  h1 {
    font-size: clamp(2.75rem, 7vw, 4.5rem);
  }
  h1 .hand {
    display: block;
    font-size: 0.5em;
    color: var(--accent-text);
  }
  .title__desc {
    max-width: 32rem;
    color: #ede3d2;
    font-size: 1.1875rem;
  }
  .title__unfit,
  .title__failed {
    max-width: var(--measure);
    padding: 12px 16px;
    border-left: 4px solid var(--golden);
    background: var(--paper-raised);
    color: var(--ink);
  }
  .title__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .start :global(.start__butterfly) {
    transform-origin: center;
  }
  .start:hover :global(.start__butterfly),
  .start:focus-visible :global(.start__butterfly) {
    animation: flutter 0.35s ease-in-out infinite alternate;
  }
  @media (prefers-reduced-motion: reduce) {
    .start:hover :global(.start__butterfly),
    .start:focus-visible :global(.start__butterfly) {
      animation: none;
    }
  }
  .credits-link {
    padding: 0;
    border: 0;
    background: none;
    color: var(--link);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    cursor: var(--cursor-link, pointer);
    min-height: 44px;
  }
  .credits {
    width: min(560px, calc(100% - 24px));
    padding: clamp(18px, 4vw, 32px);
    border: 0;
    border-radius: 6px;
    background: var(--paper-raised);
    color: var(--ink);
  }
  .credits::backdrop {
    background: rgb(30 27 36 / 0.45);
  }
  .credits h2 {
    font-size: 2rem;
  }
  .credits h3 {
    margin-top: 16px;
    font-size: 1.25rem;
  }
  .credits ul {
    padding-left: 20px;
  }
  .credits .hand {
    margin-block: 16px;
    font-size: 1.375rem;
  }
  .title__note {
    font-size: 1.375rem;
    color: var(--ink-quiet);
  }

  .stage:not([hidden]) {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #2a2140;
  }
  .stage__canvas {
    position: absolute;
    inset: 0;
  }
  .stage__vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at 50% 45%, transparent 55%, rgb(30 27 36 / 0.55));
  }
  .stage__loader:not([hidden]) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: #f4ebdd;
    font-family: var(--font-hand);
    font-size: 1.5rem;
    /* Opaque, the room's own colour: nothing shows until it's all loaded. */
    background: #2a2140;
  }
  .stage__loader--done {
    animation: stage-fade-out 0.4s forwards;
  }
  @keyframes stage-fade-out {
    to {
      opacity: 0;
    }
  }
  .stage__loader :global(.stage__butterfly) {
    animation:
      flutter 0.5s ease-in-out infinite alternate,
      stage-pulse 1.6s ease-in-out infinite;
  }
  @keyframes stage-pulse {
    50% {
      opacity: 0.55;
    }
  }
  @keyframes flutter {
    to {
      transform: scaleX(0.4) translateY(-6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage__loader :global(.stage__butterfly) {
      animation: none;
    }
  }
  .stage__back {
    position: absolute;
    top: 16px;
    left: 16px;
    background: #f4ebdd;
    color: #1e1b24;
    border-color: #f4ebdd;
  }
  .stage__back:hover {
    background: #e8a657;
    color: #1e1b24;
  }
  :global(html.story-open) {
    overflow: hidden;
  }
</style>

<!-- Story mode's React UI renders outside this component's scope, so its styles are global and prefixed. -->
<style is:global>
  .story-objects {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .story-scene {
    position: absolute;
    inset: 0;
  }
  .story-thought {
    position: absolute;
    left: 50%;
    top: 16px;
    translate: -50% 0;
    width: max-content;
    max-width: calc(100% - 280px);
    padding: 8px 18px;
    border-radius: 999px;
    background: rgb(244 235 221 / 0.92);
    color: #1e1b24;
    font-family: var(--font-hand);
    font-size: 1.5rem;
    line-height: 1.3;
    text-align: center;
    pointer-events: none;
  }
  .story-thought:empty {
    display: none;
  }
  /* On phones the Back and mute buttons take the top corners, so the thought drops below them. */
  @media (max-width: 640px) {
    .story-thought {
      top: 72px;
      max-width: calc(100% - 32px);
    }
  }
  .story-hint {
    position: absolute;
    left: 50%;
    bottom: 20px;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 10px;
    width: max-content;
    max-width: calc(100% - 136px);
    margin: 0;
    padding: 8px 18px 8px 12px;
    border-radius: 999px;
    background: rgb(244 235 221 / 0.92);
    color: #1e1b24;
    font-family: var(--font-hand);
    font-size: 1.3rem;
    line-height: 1.2;
    pointer-events: none;
    animation: hint-in 600ms ease-out both;
  }
  .story-hint__hand {
    flex: none;
    animation: hint-tap 1.6s ease-in-out infinite;
  }
  .story-hint__ripple {
    transform-origin: 9px 5px;
    animation: hint-ripple 1.6s ease-out infinite;
  }
  @keyframes hint-in {
    from {
      opacity: 0;
      translate: -50% 12px;
    }
  }
  @keyframes hint-tap {
    0%,
    60%,
    100% {
      transform: translateY(0);
    }
    30% {
      transform: translateY(3px) scale(0.92);
    }
  }
  @keyframes hint-ripple {
    0%,
    25% {
      opacity: 0;
      transform: scale(0.4);
    }
    35% {
      opacity: 1;
    }
    80%,
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .story-hint,
    .story-hint__hand,
    .story-hint__ripple {
      animation: none;
    }
  }
  .story-hud {
    position: absolute;
    left: 50%;
    bottom: 76px;
    translate: -50% 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px;
    width: max-content;
    max-width: calc(100% - 32px);
  }
  .story-chip {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 6px 16px;
    border: 0;
    border-radius: 999px;
    background: #e8a657;
    color: #1e1b24;
    font: inherit;
    font-weight: 700;
    text-decoration: none;
    cursor: var(--cursor-link, pointer);
  }
  .story-chip:hover {
    background: #f4ebdd;
    color: #1e1b24;
  }
  .story-hud__change {
    min-height: 40px;
    padding: 6px 10px;
    border: 0;
    background: none;
    color: #f4ebdd;
    font: inherit;
    text-decoration: underline;
    cursor: var(--cursor-link, pointer);
  }
  .story-mute {
    position: absolute;
    top: 16px;
    right: 16px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: #f4ebdd;
    color: #1e1b24;
    cursor: var(--cursor-link, pointer);
  }
  .story-fullscreen {
    position: absolute;
    right: 16px;
    bottom: 16px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: #f4ebdd;
    color: #1e1b24;
    cursor: var(--cursor-link, pointer);
  }
  .story-mute[aria-pressed='true'] {
    background: #4a4350;
    color: #f4ebdd;
  }
  .story-tracks button {
    padding: 4px 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: var(--cursor-link, pointer);
  }
  .story-tracks button[aria-current='true'] {
    font-weight: 700;
    color: var(--accent-text);
  }
  .story-sliders {
    display: grid;
    gap: 12px;
  }
  .story-sliders label {
    display: grid;
    grid-template-columns: 9rem 1fr;
    align-items: center;
    gap: 12px;
    font-weight: 700;
  }
  .story-sliders input {
    accent-color: #e8a657;
    min-height: 44px;
  }
  .story-rewind {
    position: absolute;
    top: 20px;
    left: 50%;
    translate: -50% 0;
    color: #f4ebdd;
    filter: drop-shadow(0 2px 6px rgb(30 27 36 / 0.6));
  }
  .story-debug {
    position: absolute;
    top: 16px;
    left: 50%;
    z-index: 1;
    translate: -50% 0;
    display: flex;
    gap: 8px;
  }
  .story-debug [aria-pressed='true'] {
    background: #f4ebdd;
  }
  .story-choice {
    width: min(520px, calc(100% - 24px));
  }

  .story-panel {
    width: min(720px, calc(100% - 24px));
    max-height: min(86vh, 900px);
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: var(--paper-raised);
    color: var(--ink);
    box-shadow: 0 24px 60px rgb(30 27 36 / 0.45);
  }
  .story-panel::backdrop {
    background: rgb(30 27 36 / 0.45);
  }
  .story-panel__page {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(18px, 4vw, 36px);
    /* Faint ruled lines, like a journal page. */
    background: repeating-linear-gradient(to bottom, transparent 0 31px, color-mix(in srgb, var(--rule) 45%, transparent) 31px 32px);
  }
  .story-panel__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }
  .story-panel h2 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
  }
  .story-panel h3 {
    margin-top: 10px;
    font-size: 1.375rem;
  }
  .story-panel ul,
  .story-panel ol {
    margin: 0;
    padding-left: 20px;
  }
  .story-panel img {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .story-panel__close {
    flex: none;
    min-height: 44px;
    padding: 8px 16px;
  }
  .story-meta {
    color: var(--ink-quiet);
    font-size: 0.9375rem;
  }
  .story-hook {
    font-size: 1.5rem;
    color: var(--accent-text);
  }
  .story-facts,
  .story-skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px 24px;
    margin: 0;
  }
  .story-facts dt,
  .story-skills dt {
    font-weight: 700;
  }
  .story-facts dd,
  .story-skills dd {
    margin: 0;
  }
  .story-panel .story-chips,
  .story-panel .story-cards,
  .story-panel .story-grid,
  .story-panel .story-thread,
  .story-panel .story-timeline {
    padding: 0;
    list-style: none;
  }
  .story-panel .story-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .story-chips li,
  .story-badge {
    padding: 2px 10px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.8125rem;
  }
  .story-badge {
    margin-left: 8px;
  }
  .story-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    font-weight: 700;
  }
  .story-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .story-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
  }
  .story-grid button {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
