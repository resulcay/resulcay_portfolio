---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Butterfly from '@/components/Butterfly.astro';
import type { Locale } from '@/domain/schemas';
import { content } from '@/lib/content';
import { localizePath, t } from '@/i18n/ui';
import { turnstileSiteKey } from '@/lib/auth';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const [profile, music] = await Promise.all([content.getProfile(), content.listMusic()]);
// The phone in the room holds the contact form.
const siteKey = turnstileSiteKey();
---
<BaseLayout lang={lang} title={t(lang, 'nav.story')} description={t(lang, 'story.description')}>
  <section class="title wrap" aria-labelledby="story-title">
    <div class="poster" aria-hidden="true">
      <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="story-sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#5b4b8a"></stop>
            <stop offset="0.55" stop-color="#e8a657"></stop>
            <stop offset="1" stop-color="#f6d3a0"></stop>
          </linearGradient>
          <radialGradient id="story-sun">
            <stop offset="0" stop-color="#fff3d6"></stop>
            <stop offset="0.45" stop-color="#ffd59a" stop-opacity="0.9"></stop>
            <stop offset="1" stop-color="#e8a657" stop-opacity="0"></stop>
          </radialGradient>
        </defs>
        <rect width="400" height="300" fill="url(#story-sky)"></rect>
        <circle cx="282" cy="196" r="90" fill="url(#story-sun)"></circle>
        <circle cx="282" cy="196" r="28" fill="#fff0cf"></circle>
        <path d="M0 214 C60 190 110 200 170 186 C230 172 300 196 400 178 L400 300 L0 300Z" fill="#2f6f73"></path>
        <path d="M0 246 C70 228 140 240 210 226 C280 212 340 236 400 222 L400 300 L0 300Z" fill="#1e1b24"></path>
        <path d="M54 246 L58 150 M58 150 L46 158 M58 150 L70 158 M120 236 L123 160 M123 160 L112 167 M123 160 L134 167" stroke="#1e1b24" stroke-width="2.5" fill="none"></path>
        <path d="M58 156 C80 170 100 170 123 165" stroke="#1e1b24" stroke-width="1" fill="none"></path>
        <path d="M150 90 q6 -6 12 0 q6 -6 12 0 M190 70 q5 -5 10 0 q5 -5 10 0" stroke="#1e1b24" stroke-width="1.6" fill="none"></path>
      </svg>
      <Butterfly size={40} class="poster__butterfly" />
    </div>

    <div class="title__text">
      <h1 id="story-title"><span class="hand">{t(lang, 'home.kicker')}:</span> {t(lang, 'home.title')}</h1>
      <p class="title__desc">{t(lang, 'story.description')}</p>
      <p class="title__unfit" data-unfit hidden>{t(lang, 'story.unfit')}</p>
      <div class="title__actions">
        <button class="button button--primary start" type="button" data-start data-anyway={t(lang, 'story.tryAnyway')}>
          <Butterfly size={18} class="start__butterfly" />
          <span data-start-label>{t(lang, 'story.start')}</span>
        </button>
        <a class="button" href={localizePath('/', lang)}>{t(lang, 'story.journal')}</a>
        <a class="button" href={profile.cvPath} download>{t(lang, 'nav.cv')}</a>
      </div>
      <p class="hand title__note">{t(lang, 'story.headphones')}</p>
      <p><button type="button" class="credits-link" data-credits-open>{t(lang, 'story.credits')}</button></p>
      <p class="title__failed" data-failed role="alert" hidden>{t(lang, 'story.failed')}</p>
    </div>
  </section>

  <dialog class="credits" data-credits aria-labelledby="credits-title">
    <h2 id="credits-title">{t(lang, 'story.credits')}</h2>
    <h3>{t(lang, 'story.music')}</h3>
    {
      music.length > 0 ? (
        <ul>
          {music.map((track) => (
            <li>
              <strong>{track.title}</strong> · {track.artist} · {t(lang, 'story.license')}: {track.license} ·{' '}
              <a href={track.sourceUrl} rel="noopener noreferrer" target="_blank">{t(lang, 'story.source')}</a>
              {track.credit && <p>{track.credit[lang]}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <p>{t(lang, 'story.noTracks')}</p>
      )
    }
    <p class="hand">{t(lang, 'footer.inspired')}</p>
    <button type="button" class="button" data-credits-close>{t(lang, 'story.close')}</button>
  </dialog>

  <div class="stage" data-stage data-url={localizePath('/story/data.json', lang)} data-lang={lang} data-sitekey={siteKey} hidden>
    <div class="stage__canvas" data-canvas></div>
    <div class="stage__vignette" aria-hidden="true"></div>
    <div class="stage__loader" data-loader role="status">
      <Butterfly size={56} class="stage__butterfly" />
      <p>{t(lang, 'story.loading')}</p>
    </div>
    <button class="button stage__back" type="button" data-back>{t(lang, 'story.back')}</button>
  </div>
</BaseLayout>

<script>
  import { readDevice, storyFits } from '@/scripts/story-capability';
  import { unlockAudio } from '@/scripts/audio-unlock';

  const start = document.querySelector<HTMLButtonElement>('[data-start]')!;
  const stage = document.querySelector<HTMLElement>('[data-stage]')!;
  const canvas = document.querySelector<HTMLElement>('[data-canvas]')!;
  const loader = document.querySelector<HTMLElement>('[data-loader]')!;
  const back = document.querySelector<HTMLButtonElement>('[data-back]')!;
  const failed = document.querySelector<HTMLElement>('[data-failed]')!;

  const device = readDevice();
  if (!storyFits(device)) {
    document.querySelector<HTMLElement>('[data-unfit]')!.hidden = false;
    start.querySelector('[data-start-label]')!.textContent = start.dataset['anyway'] ?? '';
  }

  let teardown: (() => void) | undefined;
  // Bumped on every close, so a mount that finishes after Back is undone at once.
  let session = 0;

  function close() {
    session++;
    teardown?.();
    teardown = undefined;
    stage.hidden = true;
    document.documentElement.classList.remove('story-open');
    if (location.hash) history.replaceState(null, '', location.pathname + location.search);
    start.focus();
  }

  function fail(error: unknown) {
    console.error('Story mode failed to start', error);
    close();
    failed.hidden = false;
  }

  start.addEventListener('click', async (event) => {
    if (!stage.hidden) return;
    const id = ++session;
    // Inside a real click, so the browser lets sound start. A deep link's
    // automatic start isn't one; the story then waits for the first tap or key.
    const audio = event.isTrusted ? unlockAudio() : undefined;
    failed.hidden = true;
    loader.hidden = false;
    stage.hidden = false;
    document.documentElement.classList.add('story-open');
    back.focus();
    try {
      const { mountStory } = await import('@/story/main');
      const unmount = await mountStory(canvas, {
        dataUrl: stage.dataset['url']!,
        lang: stage.dataset['lang'] === 'tr' ? 'tr' : 'en',
        siteKey: stage.dataset['sitekey'],
        reducedMotion: device.reducedMotion,
        audio,
        onReady: () => (loader.hidden = true),
        onError: fail,
      });
      if (id === session) teardown = unmount;
      else unmount();
    } catch (error) {
      void audio?.close();
      if (id === session) fail(error);
    }
  });

  back.addEventListener('click', close);
  addEventListener('keydown', (event) => {
    // With a panel open, Esc closes the panel, not the whole story.
    if (event.key === 'Escape' && !stage.hidden && !stage.querySelector('dialog[open]')) close();
  });

  const credits = document.querySelector<HTMLDialogElement>('[data-credits]')!;
  document.querySelector('[data-credits-open]')!.addEventListener('click', () => credits.showModal());
  document.querySelector('[data-credits-close]')!.addEventListener('click', () => credits.close());
  credits.addEventListener('click', (event) => event.target === credits && credits.close());

  // A deep link such as /story#laptop or #project/macyap opens straight away;
  // #credits (linked from the journal's footer) opens the credits instead.
  if (location.hash === '#credits') credits.showModal();
  else if (location.hash.length > 1 && storyFits(device)) start.click();
</script>

<style>
  .title {
    display: grid;
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
    padding-top: clamp(32px, 6vw, 80px);
  }
  @media (min-width: 900px) {
    .title {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .poster {
    position: relative;
    aspect-ratio: 4 / 3;
    border: 10px solid var(--paper-raised);
    border-bottom-width: 36px;
    border-radius: 4px;
    box-shadow: 0 18px 40px rgb(30 27 36 / 0.25);
    rotate: -1.5deg;
    overflow: hidden;
  }
  .poster svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .poster :global(.poster__butterfly) {
    position: absolute;
    left: 58%;
    top: 30%;
  }
  .title__text {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  h1 {
    font-size: clamp(2.75rem, 7vw, 4.5rem);
  }
  h1 .hand {
    display: block;
    font-size: 0.5em;
    color: var(--accent-text);
  }
  .title__desc {
    max-width: var(--measure);
    font-size: 1.1875rem;
  }
  .title__unfit,
  .title__failed {
    max-width: var(--measure);
    padding: 12px 16px;
    border-left: 4px solid var(--golden);
    background: var(--paper-raised);
  }
  .title__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .start :global(.start__butterfly) {
    transform-origin: center;
  }
  .start:hover :global(.start__butterfly),
  .start:focus-visible :global(.start__butterfly) {
    animation: flutter 0.35s ease-in-out infinite alternate;
  }
  @media (prefers-reduced-motion: reduce) {
    .start:hover :global(.start__butterfly),
    .start:focus-visible :global(.start__butterfly) {
      animation: none;
    }
  }
  .credits-link {
    padding: 0;
    border: 0;
    background: none;
    color: var(--link);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
    min-height: 44px;
  }
  .credits {
    width: min(560px, calc(100% - 24px));
    padding: clamp(18px, 4vw, 32px);
    border: 0;
    border-radius: 6px;
    background: var(--paper-raised);
    color: var(--ink);
  }
  .credits::backdrop {
    background: rgb(30 27 36 / 0.45);
  }
  .credits h2 {
    font-size: 2rem;
  }
  .credits h3 {
    margin-top: 16px;
    font-size: 1.25rem;
  }
  .credits ul {
    padding-left: 20px;
  }
  .credits .hand {
    margin-block: 16px;
    font-size: 1.375rem;
  }
  .title__note {
    font-size: 1.375rem;
    color: var(--ink-quiet);
  }

  .stage:not([hidden]) {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #2a2140;
  }
  .stage__canvas {
    position: absolute;
    inset: 0;
  }
  .stage__vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at 50% 45%, transparent 55%, rgb(30 27 36 / 0.55));
  }
  .stage__loader:not([hidden]) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: #f4ebdd;
    font-family: var(--font-hand);
    font-size: 1.5rem;
  }
  .stage__loader :global(.stage__butterfly) {
    animation: flutter 0.5s ease-in-out infinite alternate;
  }
  @keyframes flutter {
    to {
      transform: scaleX(0.4) translateY(-6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage__loader :global(.stage__butterfly) {
      animation: none;
    }
  }
  .stage__back {
    position: absolute;
    top: 16px;
    left: 16px;
    background: #f4ebdd;
    color: #1e1b24;
    border-color: #f4ebdd;
  }
  .stage__back:hover {
    background: #e8a657;
    color: #1e1b24;
  }
  :global(html.story-open) {
    overflow: hidden;
  }
</style>

<!-- Story mode's React UI renders outside this component's scope, so its styles are global and prefixed. -->
<style is:global>
  .story-objects {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .story-scene {
    position: absolute;
    inset: 0;
  }
  .story-thought {
    position: absolute;
    left: 50%;
    bottom: 20px;
    translate: -50% 0;
    width: max-content;
    max-width: calc(100% - 32px);
    padding: 8px 18px;
    border-radius: 999px;
    background: rgb(244 235 221 / 0.92);
    color: #1e1b24;
    font-family: var(--font-hand);
    font-size: 1.5rem;
    line-height: 1.3;
    text-align: center;
    pointer-events: none;
  }
  .story-thought:empty {
    display: none;
  }
  .story-hud {
    position: absolute;
    left: 50%;
    bottom: 76px;
    translate: -50% 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px;
    width: max-content;
    max-width: calc(100% - 32px);
  }
  .story-chip {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 6px 16px;
    border: 0;
    border-radius: 999px;
    background: #e8a657;
    color: #1e1b24;
    font: inherit;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }
  .story-chip:hover {
    background: #f4ebdd;
    color: #1e1b24;
  }
  .story-hud__change {
    min-height: 40px;
    padding: 6px 10px;
    border: 0;
    background: none;
    color: #f4ebdd;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  .story-mute {
    position: absolute;
    top: 16px;
    right: 16px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: #f4ebdd;
    color: #1e1b24;
    cursor: pointer;
  }
  .story-mute[aria-pressed='true'] {
    background: #4a4350;
    color: #f4ebdd;
  }
  .story-tracks button {
    padding: 4px 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .story-tracks button[aria-current='true'] {
    font-weight: 700;
    color: var(--accent-text);
  }
  .story-sliders {
    display: grid;
    gap: 12px;
  }
  .story-sliders label {
    display: grid;
    grid-template-columns: 9rem 1fr;
    align-items: center;
    gap: 12px;
    font-weight: 700;
  }
  .story-sliders input {
    accent-color: #e8a657;
    min-height: 44px;
  }
  .story-rewind {
    position: absolute;
    top: 20px;
    left: 50%;
    translate: -50% 0;
    color: #f4ebdd;
    filter: drop-shadow(0 2px 6px rgb(30 27 36 / 0.6));
  }
  .story-debug {
    position: absolute;
    top: 16px;
    left: 50%;
    z-index: 1;
    translate: -50% 0;
    display: flex;
    gap: 8px;
  }
  .story-debug [aria-pressed='true'] {
    background: #f4ebdd;
  }
  .story-choice {
    width: min(520px, calc(100% - 24px));
  }

  .story-panel {
    width: min(720px, calc(100% - 24px));
    max-height: min(86vh, 900px);
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: var(--paper-raised);
    color: var(--ink);
    box-shadow: 0 24px 60px rgb(30 27 36 / 0.45);
  }
  .story-panel::backdrop {
    background: rgb(30 27 36 / 0.45);
  }
  .story-panel__page {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(18px, 4vw, 36px);
    /* Faint ruled lines, like a journal page. */
    background: repeating-linear-gradient(to bottom, transparent 0 31px, color-mix(in srgb, var(--rule) 45%, transparent) 31px 32px);
  }
  .story-panel__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }
  .story-panel h2 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
  }
  .story-panel h3 {
    margin-top: 10px;
    font-size: 1.375rem;
  }
  .story-panel ul,
  .story-panel ol {
    margin: 0;
    padding-left: 20px;
  }
  .story-panel img {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .story-panel__close {
    flex: none;
    min-height: 44px;
    padding: 8px 16px;
  }
  .story-meta {
    color: var(--ink-quiet);
    font-size: 0.9375rem;
  }
  .story-hook {
    font-size: 1.5rem;
    color: var(--accent-text);
  }
  .story-facts,
  .story-skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px 24px;
    margin: 0;
  }
  .story-facts dt,
  .story-skills dt {
    font-weight: 700;
  }
  .story-facts dd,
  .story-skills dd {
    margin: 0;
  }
  .story-panel .story-chips,
  .story-panel .story-cards,
  .story-panel .story-grid,
  .story-panel .story-thread,
  .story-panel .story-timeline {
    padding: 0;
    list-style: none;
  }
  .story-panel .story-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .story-chips li,
  .story-badge {
    padding: 2px 10px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.8125rem;
  }
  .story-badge {
    margin-left: 8px;
  }
  .story-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    font-weight: 700;
  }
  .story-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .story-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
  }
  .story-grid button {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
    height: 100%;
    padding: 14px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    rotate: -0.6deg;
  }
  .story-grid li:nth-child(even) button {
    rotate: 0.6deg;
  }
  .story-grid button:hover,
  .story-grid button:focus-visible {
    border-color: var(--golden);
  }
  .story-grid strong {
    font-family: var(--font-display);
    font-size: 1.125rem;
  }
  .story-grid span {
    color: var(--ink-quiet);
    font-size: 0.9375rem;
  }
  .story-timeline {
    display: flex;
    flex-direction: column;
    gap: 20px;
    border-left: 2px solid var(--golden);
    padding-left: 18px !important;
  }
  .story-timeline ul {
    margin-top: 6px;
  }
  .story-quote {
    margin: 0;
    padding-left: 14px;
    border-left: 3px solid var(--violet);
  }
  .story-quote footer {
    margin-top: 4px;
    font-weight: 700;
  }
  .story-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  .story-cards li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px;
    border-top: 6px solid var(--golden);
    background: var(--paper);
  }
  .story-cards span {
    color: var(--ink-quiet);
  }
  .story-soon {
    font-size: 1.75rem;
  }
  .story-phases {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .story-phases label {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-weight: 700;
  }
  .story-thread {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .story-thread li {
    width: fit-content;
    max-width: 85%;
    padding: 8px 14px;
    border-radius: 18px 18px 18px 4px;
    background: var(--paper);
    border: 1px solid var(--rule);
  }
  .story-thread a {
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .story-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .story-form label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-weight: 700;
  }
  .story-form input,
  .story-form textarea {
    padding: 10px 12px;
    border: 1.5px solid var(--rule);
    border-radius: 8px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-weight: 400;
  }
  .story-form small {
    color: #b3402a;
    font-weight: 400;
  }
  .story-toast {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: 10px 16px;
    border-radius: 8px;
    background: #1e1b24;
    color: #f4ebdd;
    font-family: var(--font-hand);
    font-size: 1.375rem;
    text-align: center;
  }
</style>
