---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Butterfly from '@/components/Butterfly.astro';
import type { Locale } from '@/domain/schemas';
import { localizePath, t } from '@/i18n/ui';
import { turnstileSiteKey } from '@/lib/auth';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
// The butterfly opens the admin sign-in after five quick clicks. The dialog
// is the same on every missing page, so it says nothing about any URL.
const siteKey = turnstileSiteKey();
---
<BaseLayout lang={lang} title="404" description={t(lang, 'notFound.body')} noindex>
  <section class="wrap lost" aria-labelledby="lost-title">
    <figure class="polaroid">
      <svg viewBox="0 0 340 340" role="img" aria-label={lang === 'en' ? 'Polaroid of an empty cliff at dusk' : 'Alacakaranlıkta boş bir uçurumun Polaroid fotoğrafı'}>
        <rect width="340" height="120" fill="#3b3060"></rect>
        <rect y="120" width="340" height="60" fill="#5b4b8a"></rect>
        <rect y="180" width="340" height="40" fill="#d98a62"></rect>
        <circle cx="250" cy="226" r="34" fill="#f6c47e"></circle>
        <rect y="226" width="340" height="114" fill="#2f6f73"></rect>
        <path d="M0 250 C60 240 120 236 170 250 C200 258 220 290 236 340 L0 340Z" fill="#1e1b24"></path>
        <rect x="70" y="226" width="44" height="6" fill="#1e1b24"></rect>
        <rect x="74" y="232" width="4" height="14" fill="#1e1b24"></rect>
        <rect x="106" y="232" width="4" height="14" fill="#1e1b24"></rect>
      </svg>
      <figcaption>{t(lang, 'notFound.caption')}</figcaption>
    </figure>
    <div class="copy">
      <button type="button" class="lost__butterfly" data-butterfly aria-label={lang === 'en' ? 'Butterfly' : 'Kelebek'}>
        <Butterfly size={40} />
      </button>
      <p class="code" aria-hidden="true">404</p>
      <h1 id="lost-title">{t(lang, 'notFound.title')}</h1>
      <p>{t(lang, 'notFound.body')}</p>
      <div class="actions">
        <a class="button button--primary" href={localizePath('/', lang)}>
          <svg width="22" height="16" viewBox="0 0 22 16" aria-hidden="true"><path d="M11 1 L1 8 L11 15Z M21 1 L11 8 L21 15Z" fill="currentColor"></path></svg>
          {t(lang, 'notFound.rewind')}
        </a>
        <a class="button" href={localizePath('/about', lang)}>{t(lang, 'notFound.journal')}</a>
      </div>
    </div>
  </section>
  {
    siteKey && (
      <dialog class="rewind" data-rewind aria-labelledby="rewind-title">
        <form novalidate>
          <h2 id="rewind-title">Rewind</h2>
          <label>
            <span>Email</span>
            <input name="email" type="email" autocomplete="username" required maxlength="120" />
            <small data-error-for="email" />
          </label>
          <label>
            <span>Password</span>
            <input name="password" type="password" autocomplete="current-password" required maxlength="200" />
            <small data-error-for="password" />
          </label>
          <div data-turnstile data-sitekey={siteKey} />
          <p role="status" aria-live="polite" />
          <div class="rewind__actions">
            <button type="submit" class="button button--primary">Go</button>
            <button type="button" class="button" data-close>Close</button>
          </div>
        </form>
      </dialog>
    )
  }
</BaseLayout>

<script>
  const butterfly = document.querySelector<HTMLButtonElement>('[data-butterfly]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-rewind]');
  let clicks: number[] = [];
  butterfly?.addEventListener('click', () => {
    butterfly.classList.remove('is-fluttering');
    void butterfly.offsetWidth;
    butterfly.classList.add('is-fluttering');
    const now = Date.now();
    clicks = [...clicks.filter((at) => now - at < 3000), now];
    if (clicks.length >= 5 && dialog) {
      clicks = [];
      void import('@/scripts/rewind-login').then(({ openLogin }) => openLogin(dialog));
    }
  });
</script>

<style>
  .lost {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px 72px;
    padding-top: clamp(40px, 8vw, 96px);
  }
  .polaroid {
    flex: 0 1 360px;
    margin: 0 auto;
    padding: 18px 18px 56px;
    background: #fbf6ee;
    border-radius: 4px;
    transform: rotate(-4deg);
    box-shadow: 0 10px 30px rgb(30 27 36 / 0.18);
  }
  .polaroid svg {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 14px;
    font-family: var(--font-hand);
    font-size: 1.75rem;
    color: #1e1b24;
    text-align: center;
  }
  .copy {
    position: relative;
    flex: 1 1 360px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .lost__butterfly {
    position: absolute;
    right: 0;
    top: -8px;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: var(--cursor-link, pointer);
  }
  .lost__butterfly.is-fluttering :global(svg) {
    animation: flutter 0.5s ease-out;
  }
  @keyframes flutter {
    30% {
      transform: translateY(-6px) scaleX(0.7) rotate(-6deg);
    }
    60% {
      transform: translateY(-2px) scaleX(1.05);
    }
  }
  .rewind {
    width: min(100% - 32px, 400px);
    padding: 28px;
    border: 0;
    border-radius: var(--radius);
    background: var(--paper-raised);
    color: var(--ink);
    box-shadow: 0 20px 60px rgb(30 27 36 / 0.35);
  }
  .rewind::backdrop {
    background: rgb(30 27 36 / 0.6);
  }
  .rewind form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .rewind h2 {
    font-size: 1.75rem;
  }
  .rewind label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-weight: 700;
  }
  .rewind input {
    min-height: 48px;
    padding: 10px 12px;
    border: 1.5px solid var(--rule);
    border-radius: 8px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-weight: 400;
  }
  .rewind input[aria-invalid='true'] {
    border-color: #b3261e;
  }
  .rewind small {
    color: var(--accent-text);
    font-weight: 400;
  }
  .rewind [role='status']:empty,
  .rewind small:empty {
    display: none;
  }
  .rewind__actions {
    display: flex;
    gap: 12px;
  }
  .code {
    font-family: var(--font-display);
    font-size: clamp(5rem, 14vw, 8rem);
    font-weight: 600;
    line-height: 1;
    color: var(--accent-text);
  }
  h1 {
    font-size: clamp(2rem, 4.5vw, 2.75rem);
  }
  .copy > p:not(.code) {
    max-width: 46ch;
    color: var(--ink-quiet);
    font-size: 1.125rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
</style>
