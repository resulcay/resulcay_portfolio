---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TagChips from '@/components/TagChips.astro';
import { BADGES, STORES } from '@/components/store-badges';
import type { Locale, Project } from '@/domain/schemas';
import { breadcrumbLd, projectLd } from '@/lib/structured-data';
import { formatPeriod, localizePath, t, type UiKey } from '@/i18n/ui';

interface Props {
  lang: Locale;
  project: Project;
}
const { lang, project } = Astro.props;
const period = formatPeriod(project.start, project.end, lang);
const groups: { key: UiKey; tags: readonly string[] }[] = [
  { key: 'group.appTypes', tags: project.appTypes },
  { key: 'group.platforms', tags: project.platforms },
  { key: 'group.pricing', tags: [project.pricing] },
  { key: 'group.workType', tags: [project.workType] },
  { key: 'group.languages', tags: project.languages },
  { key: 'group.tech', tags: project.tech },
  { key: 'group.status', tags: [project.status] },
  { key: 'group.category', tags: [project.category] },
];
// The stores' own badges first, then buttons for the website and the source code.
const stores = STORES.flatMap((store) => (project.links[store] ? [{ store, href: project.links[store]!, badge: BADGES[store] }] : []));
const buttons = (['website', 'repository'] as const).flatMap((key) => (project.links[key] ? [{ key, href: project.links[key]! }] : []));
const images = project.images ?? [];
const [logo, ...galleryImages] = images;
---
<BaseLayout
  lang={lang}
  title={project.title}
  description={project.hook[lang]}
  ogType="article"
  ogImage={images[0] && `/media/${images[0].key}`}
  jsonLd={[
    projectLd(project, lang),
    breadcrumbLd([
      { name: 'Resul Çay', path: localizePath('/', lang) },
      { name: t(lang, 'projects.title'), path: localizePath('/projects', lang) },
      { name: project.title, path: localizePath(`/projects/${project.slug}`, lang) },
    ]),
  ]}
>
  <article class="wrap project">
    <a class="back" href={localizePath('/projects', lang)}>← {t(lang, 'project.back')}</a>
    <header class="project-header">
      <div class="project-header__copy">
        <h1>{project.title}</h1>
        <p class="hook">{project.hook[lang]}</p>
        <TagChips tags={[...project.appTypes, ...project.platforms]} lang={lang} tone="strong" />
      </div>
      {
        logo && (
          <figure class="project-logo">
            <img src={`/media/${logo.key}`} alt={logo.alt[lang]} width={logo.width} height={logo.height} loading="eager" fetchpriority="high" decoding="async" />
          </figure>
        )
      }
    </header>
    {
      galleryImages.length > 0 && (
        <div class="gallery swiper" data-project-gallery aria-label={t(lang, 'project.gallery')}>
          <div class="swiper-wrapper">
            {galleryImages.map((img, i) => (
              <figure class="gallery__slide swiper-slide" role="group" aria-roledescription="slide" aria-label={`${t(lang, 'project.image')} ${i + 1} / ${galleryImages.length}`}>
                <img
                  src={`/media/${img.key}`}
                  alt={img.alt[lang]}
                  width={img.width}
                  height={img.height}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                />
              </figure>
            ))}
          </div>
          {galleryImages.length > 1 && (
            <>
              <button type="button" class="gallery__arrow gallery__arrow--prev swiper-button-prev" aria-label={t(lang, 'project.previousImage')} />
              <button type="button" class="gallery__arrow gallery__arrow--next swiper-button-next" aria-label={t(lang, 'project.nextImage')} />
              <div class="gallery__pagination swiper-pagination" />
            </>
          )}
        </div>
      )
    }
    <div class="layout">
      <div class="story">
        <p>{project.story[lang]}</p>
        {
          project.highlights.length > 0 && (
            <ul class="highlights">
              {project.highlights.map((h) => (
                <li class="hand">{h[lang]}</li>
              ))}
            </ul>
          )
        }
        {
          (stores.length > 0 || buttons.length > 0) && (
            <ul class="get" aria-label={t(lang, 'project.links')}>
              {stores.map(({ store, href, badge }) => (
                <li>
                  <a class={`badge badge--${store}`} href={href} rel="noopener">
                    <img src={badge.src[lang]} alt={badge.alt[lang]} height={badge.height} width={badge.width[lang]} />
                  </a>
                </li>
              ))}
              {buttons.map(({ key, href }) => (
                <li>
                  <a class="button" href={href} rel="noopener">
                    {key === 'website' ? (
                      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M3 12h18M12 3c2.6 2.6 3.8 5.6 3.8 9s-1.2 6.4-3.8 9c-2.6-2.6-3.8-5.6-3.8-9S9.4 5.6 12 3Z" />
                      </svg>
                    ) : (
                      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M8.5 7 3.5 12l5 5M15.5 7l5 5-5 5M13.5 4.5l-3 15" />
                      </svg>
                    )}
                    {t(lang, key === 'website' ? 'link.website' : 'link.repository')}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <aside aria-labelledby="details-title">
        <h2 id="details-title" class="eyebrow">{t(lang, 'project.details')}</h2>
        <dl>
          <div><dt>{t(lang, 'project.role')}</dt><dd>{project.role[lang]}</dd></div>
          {period && <div><dt>{t(lang, 'project.period')}</dt><dd>{period}</dd></div>}
          {
            groups
              .filter((g) => g.tags.length > 0)
              .map((g) => (
                <div>
                  <dt>{t(lang, g.key)}</dt>
                  <dd><TagChips tags={g.tags} lang={lang} /></dd>
                </div>
              ))
          }
        </dl>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 32px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }
  .project-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
  }
  .project-header__copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .project-logo {
    flex: 0 0 clamp(120px, 18vw, 220px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    margin: -20px 0 0;
    padding: clamp(14px, 2vw, 24px);
    border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
    border-radius: 14px;
    background: var(--paper-raised);
    box-shadow: 0 10px 24px rgb(30 27 36 / 0.1);
  }
  .project-logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  h1 {
    font-size: clamp(2.75rem, 7vw, 4.5rem);
  }
  .hook {
    font-size: 1.25rem;
    color: var(--ink-quiet);
    max-width: var(--measure);
  }
  .gallery {
    position: relative;
    width: 100%;
    min-width: 0;
    padding: 0 52px 36px;
    --swiper-navigation-size: 22px;
    --swiper-theme-color: var(--ink);
    border-radius: 10px;
    background: var(--paper-raised);
  }
  .gallery__slide {
    display: grid;
    place-items: center;
    margin: 0;
    min-width: 0;
  }
  .gallery__slide img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 60vh;
    object-fit: contain;
    border-radius: 10px;
    background: var(--paper);
  }
  @media (max-width: 640px) {
    .project-header {
      gap: 18px;
    }
    .project-logo {
      flex-basis: clamp(88px, 24vw, 140px);
      margin-top: -8px;
    }
    .gallery {
      padding-inline: 38px;
    }
  }
  .gallery__arrow,
  .gallery__pagination {
    color: var(--ink);
  }
  .gallery__arrow {
    width: 42px;
    height: 42px;
    border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
    border-radius: 50%;
    background: var(--paper);
    cursor: pointer;
  }
  .gallery__arrow:hover {
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }
  .gallery :global(.swiper-pagination-bullet-active) {
    background: var(--golden);
  }
  .layout {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 56px;
    align-items: flex-start;
  }
  .story {
    flex: 999 1 480px;
    min-width: 0;
    max-width: var(--measure);
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: 1.125rem;
  }
  .highlights {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .highlights li {
    padding-left: 1.1em;
    text-indent: -1.1em;
    font-size: 1.75rem;
  }
  .highlights li::before {
    content: '-';
    display: inline-block;
    width: 1.1em;
    text-indent: 0;
  }
  aside {
    flex: 1 1 280px;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--paper-raised);
  }
  dl {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 16px 0 0;
  }
  dt {
    font-weight: 700;
    margin-bottom: 6px;
  }
  dd {
    margin: 0;
  }
  /* The store badges and the website and source buttons, under the title. */
  .get {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 14px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }
  /* Flex items, so no text line under each link pushes it off centre. */
  .get > li {
    display: flex;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border-radius: 8px;
    transition: translate 0.15s;
  }
  .badge:hover {
    translate: 0 -2px;
  }
  /* Every badge's dark plate comes out 44px tall, like the buttons beside it. Sized here: the site's
     img { height: auto } would otherwise show each at its file's own size. */
  .badge img {
    display: block;
    flex: none;
    max-width: none;
    width: auto;
    height: 44px;
  }
  /* Google's PNGs carry a transparent margin (English: rows 41–208 of 250; Turkish: 30–219, full width). */
  .badge--googlePlay img {
    height: 65.5px;
    margin: -10.7px;
  }
  /* Microsoft's lettering is small for its plate, so its badge is drawn larger. */
  .badge--microsoftStore img {
    height: 54px;
  }
  :lang(tr) .badge--googlePlay img {
    height: 58px;
    margin: -7px 0;
  }
  .get .button {
    min-height: 44px;
    height: 44px;
    padding-block: 0;
  }
  .get .button svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (prefers-reduced-motion: reduce) {
    .badge {
      transition: none;
    }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { A11y, Navigation, Pagination } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/pagination';

  const gallery = document.querySelector<HTMLElement>('[data-project-gallery]');
  if (gallery) {
    new Swiper(gallery, {
      a11y: {
        containerMessage: gallery.getAttribute('aria-label') ?? null,
      },
      modules: [A11y, Navigation, Pagination],
      navigation: {
        nextEl: gallery.querySelector('.swiper-button-next'),
        prevEl: gallery.querySelector('.swiper-button-prev'),
      },
      pagination: {
        clickable: true,
        el: gallery.querySelector('.swiper-pagination'),
      },
      speed: 500,
    });
  }
</script>
