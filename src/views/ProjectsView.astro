---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PolaroidCard from '@/components/PolaroidCard.astro';
import type { Locale } from '@/domain/schemas';
import { publicProjects } from '@/application/content';
import { content } from '@/lib/content';
import { breadcrumbLd } from '@/lib/structured-data';
import { localizePath, t } from '@/i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const projects = publicProjects(await content.listProjects());
---
<BaseLayout
  lang={lang}
  title={t(lang, 'projects.title')}
  description={t(lang, 'projects.intro')}
  jsonLd={breadcrumbLd([
    { name: 'Resul Çay', path: localizePath('/', lang) },
    { name: t(lang, 'projects.title'), path: localizePath('/projects', lang) },
  ])}
>
  <section class="wrap page" aria-labelledby="projects-title">
    <p class="hand">{projects.length} {lang === 'en' ? 'Polaroids' : 'Polaroid'}</p>
    <h1 id="projects-title">{t(lang, 'projects.title')}</h1>
    <p class="intro">{t(lang, 'projects.intro')}</p>
    <div class="grid">
      {projects.map((project, i) => <PolaroidCard project={project} lang={lang} index={i} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: clamp(40px, 7vw, 88px);
  }
  .page .hand {
    font-size: 1.75rem;
  }
  h1 {
    font-size: clamp(2.75rem, 7vw, 4.5rem);
  }
  .intro {
    max-width: var(--measure);
    color: var(--ink-quiet);
    margin-bottom: 32px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 40px 32px;
  }
</style>
